    local KNIFE_ORDER = { "Karambit", "M9 Bayonet", "Butterfly Knife", "Flip Knife", "Gut Knife", "Stiletto Knife", "Skeleton Knife", "CT Knife", "T Knife" }
    local KNIVES = {}
