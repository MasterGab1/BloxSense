            if row.card.Visible then matches+=1 end
        end
        empty.Visible=matches==0
        grid.CanvasPosition=Vector2.zero
    end
    local function card(weapon,skin,order,isModel)
        local labelText=isModel and ((weapon=="CT Knife" or weapon=="T Knife") and "Default" or weapon) or skin:gsub("_PATTERN_"," · ")
        local frame=create("TextButton",{Name="Card_"..labelText,Text="",AutoButtonColor=false,
            BackgroundColor3=THEME.Box,BorderSizePixel=0,LayoutOrder=order},grid)
        rounded(frame,11)
        local stroke=create("UIStroke",{Color=THEME.Border,Thickness=1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},frame)
        create("UIGradient",{Rotation=90,Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(192,198,212))},frame)
        local image=create("ImageLabel",{Name="Preview",BackgroundTransparency=1,ScaleType=Enum.ScaleType.Fit,
            Position=UDim2.fromOffset(10,8),Size=UDim2.new(1,-20,1,-58)},frame)
        local label=create("TextLabel",{Text=labelText,BackgroundTransparency=1,TextColor3=THEME.Text,TextSize=12,
            TextTruncate=Enum.TextTruncate.AtEnd,Position=UDim2.new(0,6,1,-43),Size=UDim2.new(1,-12,0,18)},frame)
        local detail=isModel and (#skinNamesFor(weapon).." finishes  ›") or "Apply finish"
        local action=create("TextLabel",{Name="Action",Text=detail,BackgroundTransparency=1,
            TextColor3=THEME.Muted,TextSize=11,TextTruncate=Enum.TextTruncate.AtEnd,
            Position=UDim2.new(0,6,1,-23),Size=UDim2.new(1,-12,0,16)},frame)
        local check=create("TextLabel",{Text="✓",BackgroundTransparency=1,TextColor3=THEME.Accent,TextSize=17,
            AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-6,0,4),Size=UDim2.fromOffset(20,20),Visible=false},frame)
        table.insert(rows,{weapon=weapon,skin=skin,card=frame,stroke=stroke,label=label,check=check,
            action=action,detail=detail,isModel=isModel,search=weapon.." "..skin})
        frame.MouseEnter:Connect(function()
            frame.BackgroundColor3=selected(weapon,skin) and Color3.fromRGB(43,57,91) or Color3.fromRGB(43,45,53)
        end)
        frame.MouseLeave:Connect(function()markSelected()end)
        frame.MouseButton1Click:Connect(function()
            if isModel then openWeapon=weapon;search.Text="";render() else applySkin(weapon,skin) end
        end)
        frame.MouseButton2Click:Connect(function()if isModel then openWeapon=weapon;search.Text="";render() end end)
        local token=version
        task.spawn(function()
            local entries=skinEntries(weapon)
            local info=entries[skin] or library.GetSkinInformation(weapon,skin)
            local art=thumbFor(info,weapon)
            if token==version and image.Parent and not context.IsDestroyed() then image.Image=art end
        end)
    end
    render=function()
        version+=1
        for _,row in ipairs(rows)do row.card:Destroy() end
        rows={}
        back.Visible=openWeapon~=nil
        back.Text=mode=="Knife" and "‹ All knives" or "‹ All guns"
        knivesButton.Visible=openWeapon==nil
        gunsButton.Visible=openWeapon==nil
        search.PlaceholderText=openWeapon and "Search finishes…" or "Search models…"
        knivesButton.TextColor3=mode=="Knife" and THEME.Accent or THEME.Text
        gunsButton.TextColor3=mode=="Guns" and THEME.Accent or THEME.Text
        knivesButton.BackgroundColor3=mode=="Knife" and Color3.fromRGB(31,43,72) or THEME.Box
        gunsButton.BackgroundColor3=mode=="Guns" and Color3.fromRGB(31,43,72) or THEME.Box
        heading.Text=openWeapon or (mode=="Knife" and "Knife collection" or "Gun collection")
        hint.Text=openWeapon and (#skinNamesFor(openWeapon).." finishes · Click one to apply") or "Choose a model to explore its finishes"
        if openWeapon then
            for index,skin in ipairs(skinNamesFor(openWeapon))do card(openWeapon,skin,index,false)end
        else
            local defaultKnife=player:GetAttribute("Team")=="Terrorists" and "T Knife" or "CT Knife"
            local names=mode=="Knife" and {defaultKnife,"Butterfly Knife","Karambit","M9 Bayonet","Skeleton Knife","Stiletto Knife","Flip Knife","Gut Knife"} or weapons
            for index,weapon in ipairs(names)do
                local skin=module.Selections[weapon] or stock(weapon)
                if skin then card(weapon,skin,index,true) end
            end
        end
        markSelected();filter()
    end
    knivesButton.MouseButton1Click:Connect(function()mode="Knife";openWeapon=nil;search.Text="";render()end)
    gunsButton.MouseButton1Click:Connect(function()mode="Guns";openWeapon=nil;search.Text="";render()end)
    back.MouseButton1Click:Connect(function()openWeapon=nil;search.Text="";render()end)
    search:GetPropertyChangedSignal("Text"):Connect(filter)
    module.OpenWeapon=function(weapon)openWeapon=weapon;mode=KNIVES[weapon] and "Knife" or "Guns";search.Text="";render()end
    module.ShowModels=function(category)mode=category or "Knife";openWeapon=nil;search.Text="";render()end
    module.Browser=body
    context.SettingsTab:AddButton({Title="Reset all skins",Callback=function()
        module.Selections={};module.KnifeOverride=nil;toggle:SetValue(false);markSelected();refreshStatus("All finishes reset")
    end})
    render()
    if loadedEnabled then toggle:SetValue(true) end
    function module:Destroy()
        version+=1
        self:SetEnabled(false)
        layoutConnection:Disconnect();gridConnection:Disconnect();body:Destroy()
    end
    return module
end
end)()

Modules["snaplook"] = (function()
return function(context)
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    local input = game:GetService("UserInputService")
    local run = game:GetService("RunService")
    local storage = game:GetService("ReplicatedStorage")
    local cameraController = require(storage.Controllers.CameraController)
    local inventory = require(storage.Controllers.InventoryController)
    local module = {Enabled = false, Active = false, Mode = "Hold", Key = Enum.KeyCode.H,
        Distance = 8, FirstPersonAiming = true, Held = false, Latched = false, Focused = true, Status = "Off"}
    local original, wrapper, request, hiddenViewmodel
    local connections = {}
    function module:WantsThirdPerson()
        if not self.Enabled or context.IsDestroyed() then return false, "Off" end
        if not self.Focused then return false, "Unfocused" end
        local character = player.Character
        if not character or not character.Parent or character:GetAttribute("Dead") == true
            or player:GetAttribute("IsSpectating") == true then return false, "Waiting to spawn" end
        if not cameraController.IsEnabled() then return false, "Game camera inactive" end
        if self.Mode == "Hold" and not self.Held then return false, "Hold " .. self.Key.Name end
        if self.Mode == "Toggle" and not self.Latched then return false, "Press " .. self.Key.Name end
        local item = inventory.peekCurrentEquippedForMovement()
        if self.FirstPersonAiming and item and item.IsAiming then return false, "Aiming" end
        return true, "Third person"
    end
    function module:RestoreViewmodel()
        local model = hiddenViewmodel
        hiddenViewmodel = nil
        if model and not model.IsDestroyed and model.Hidden and type(model.unhide) == "function" then
            gameCall(model.unhide, model)
        end
    end
    function module:UpdateViewmodel()
        local item = inventory.peekCurrentEquippedForMovement()
        local model = self.Active and item and item.Viewmodel
        if model ~= hiddenViewmodel then self:RestoreViewmodel() end
        if model and not model.IsDestroyed and not model.Hidden and type(model.hide) == "function" then
            local ok = gameCall(model.hide, model)
            if ok then hiddenViewmodel = model end
        end
    end
    function module:Refresh()
        if not self.Enabled or not wrapper or cameraController.setPerspective ~= wrapper then return end
        local ok, err = gameCall(wrapper, request.First, request.Mouse, request.Distance)
        if not ok then self.Status = "Camera error: " .. tostring(err) end
        self:UpdateViewmodel()
    end
    function module:SetEnabled(value)
        self.Enabled = value == true
        self.Held, self.Latched = false, false
        if not self.Enabled then
            if wrapper and cameraController.setPerspective == wrapper then
                cameraController.setPerspective = original
                if request then gameCall(original, request.First, request.Mouse, request.Distance) end
            end
            self.Active = false
            self:RestoreViewmodel()
            original, wrapper, request = nil, nil, nil
            self.Status = "Off"
            return
        end
        if wrapper and cameraController.setPerspective == wrapper then self:Refresh(); return end
        original = cameraController.setPerspective
        assert(type(original) == "function", "Game perspective API unavailable")
        request = {First = player.CameraMode == Enum.CameraMode.LockFirstPerson, Mouse = false,
            Distance = player.CameraMaxZoomDistance}
        local previous = original
        wrapper = function(firstPerson, mouseEnabled, distance)
            request = {First = firstPerson, Mouse = mouseEnabled, Distance = distance}
            local wanted, status = module:WantsThirdPerson()
            -- Keep the game's camera, collision/occlusion and input processing.
            -- Only substitute its live first-person perspective request.
            module.Active = wanted and firstPerson == true
            module.Status = module.Active and "Third person" or status
            if module.Active then return previous(false, mouseEnabled, module.Distance) end
            return previous(firstPerson, mouseEnabled, distance)
        end
        cameraController.setPerspective = wrapper
        self:Refresh()
    end
    function module:HandleKey(key, began, processed)
        if key ~= self.Key then return end
        if not began then self.Held = false; self:Refresh(); return end
        if processed or not self.Enabled or not self.Focused or input:GetFocusedTextBox()
            or player:GetAttribute("IsPlayerChatting") == true
            or (not context.Window.hidden and not context.Window.minimised) then return end
        if self.Mode == "Hold" then self.Held = true
        elseif self.Mode == "Toggle" then self.Latched = not self.Latched end
        self:Refresh()
    end
    table.insert(connections, input.InputBegan:Connect(function(event, processed)
        module:HandleKey(event.KeyCode, true, processed)
    end))
    table.insert(connections, input.InputEnded:Connect(function(event)
        module:HandleKey(event.KeyCode, false, false)
    end))
    table.insert(connections, input.WindowFocusReleased:Connect(function()
        module.Focused = false; module.Held = false; module:Refresh()
    end))
    table.insert(connections, input.WindowFocused:Connect(function() module.Focused = true; module:Refresh() end))
    table.insert(connections, player.CharacterRemoving:Connect(function()
        module.Held = false; module.Active = false; module:RestoreViewmodel()
    end))
    table.insert(connections, run.Heartbeat:Connect(function()
        if not module.Enabled then return end
        local wanted = module:WantsThirdPerson()
        if wanted ~= module.Active then module:Refresh() else module:UpdateViewmodel() end
    end))
    local toggle = context.Tab:AddToggle("BloxSenseSnaplook", {
        Title = "Snaplook", Description = "Third-person camera. Default key: H.", Default = false,
    })
    module.Toggle = toggle
    toggle:OnChanged(function() module:SetEnabled(toggle.Value) end)
    context.Tab.Raw:CreateDropdown({name = "Activation", flag = "BloxSenseSnaplookMode",
        options = {"Hold", "Toggle", "Always"}, value = {"Hold"}, multiSelect = false,
        callback = function(value)
            local mode = type(value) == "table" and value[1] or value
            if mode ~= "Hold" and mode ~= "Toggle" and mode ~= "Always" then return end
            module.Mode = mode; module.Held = false; module.Latched = false; module:Refresh()
        end})
    local key = context.Tab:AddKeybind("BloxSenseSnaplookKey", {Title = "Snaplook key", Default = "H"})
    key:OnChanged(function(value)
        module.Key = Enum.KeyCode[value] or Enum.KeyCode.H
        module.Held = false; module.Latched = false; module:Refresh()
    end)
    context.Tab:AddSlider("BloxSenseSnaplookDistance", {Title = "Camera distance (studs)",
        Default = 8, Min = 3, Max = 20, Rounding = 0,
        Callback = function(value) module.Distance = value; module:Refresh() end})
    local aiming = context.Tab:AddToggle("BloxSenseSnaplookAiming", {Title = "First person while aiming", Default = true})
    aiming:OnChanged(function() module.FirstPersonAiming = aiming.Value; module:Refresh() end)
    function module:Destroy()
        self:SetEnabled(false)
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
    end
    return module
end
end)()

Modules["qol"] = (function()
return function(context)
    local run=game:GetService("RunService")
    local lighting=game:GetService("Lighting")
    local player=game:GetService("Players").LocalPlayer
    local module={EffectsReduced=false}
    local effects,connections={},{}
    local cameraController = require(game.ReplicatedStorage.Controllers.CameraController)
    local constants = require(game.ReplicatedStorage.Database.Custom.Constants)
    local input = game:GetService("UserInputService")
    local virtualUser = game:GetService("VirtualUser")
    local defaultFov = constants.DEFAULT_CAMERA_FOV
    local originalFov = cameraController.updateCameraFOV
    local requestedFov = cameraController.getTargetFOV()
    module.CustomFov, module.Fov = false, defaultFov
    module.AntiAfk, module.AntiAfkStatus, module.IdleResets = false, "Off", 0
    local fovWrapper = function(value)
        requestedFov = value
        -- Scope/zoom requests stay native. Do not lock FOV or change camera input.
        local target = module.CustomFov and value >= defaultFov - 0.01 and module.Fov or value
        return originalFov(target)
    end
    cameraController.updateCameraFOV = fovWrapper
    function module:RefreshFov()
        if cameraController.updateCameraFOV == fovWrapper then gameCall(fovWrapper, requestedFov) end
    end
    context.Tab.Raw:CreateSection({name="CAMERA"})
    local customFov = context.Tab:AddToggle("BloxSenseCustomFOV", {Title="Custom camera FOV", Default=false})
    customFov:OnChanged(function() module.CustomFov=customFov.Value; module:RefreshFov() end)
    context.Tab:AddSlider("BloxSenseCameraFOV", {Title="Camera FOV (game range)", Default=defaultFov,
        Min=40, Max=80, Rounding=0, Callback=function(value) module.Fov=value; module:RefreshFov() end})
    context.Tab:AddButton({Title="Restore game FOV",Callback=function() customFov:SetValue(false) end})
    context.Tab.Raw:CreateSection({name="SESSION"})
    local antiAfk = context.Tab:AddToggle("BloxSenseAntiAFK", {Title="Anti-AFK", Default=false,
        Description="Send an idle response when Roblox reports inactivity."})
    antiAfk:OnChanged(function()
        module.AntiAfk=antiAfk.Value
        module.AntiAfkStatus=antiAfk.Value and "Waiting for idle" or "Off"
    end)
    local idleBusy = false
    function module:HandleIdle()
        if not self.AntiAfk or context.IsDestroyed() or idleBusy then return end
        if input:GetFocusedTextBox() or input:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        idleBusy = true
        local down = false
        local ok, err = pcall(function()
            virtualUser:CaptureController()
            local frame = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or CFrame.new()
            virtualUser:Button2Down(Vector2.zero, frame)
            down = true
            task.wait(0.05)
        end)
        if down then
            local released, releaseError = pcall(function()
                virtualUser:Button2Up(Vector2.zero, workspace.CurrentCamera and workspace.CurrentCamera.CFrame or CFrame.new())
            end)
            if not released then ok, err = false, releaseError end
        end
        idleBusy = false
        if ok then self.IdleResets += 1 end
        self.AntiAfkStatus = not self.AntiAfk and "Off" or (ok and "Idle response sent" or "Unavailable: " .. tostring(err))
    end
    table.insert(connections, player.Idled:Connect(function() module:HandleIdle() end))
    context.Tab:AddButton({Title="Anti-AFK status", Callback=function()
        context.Notify("Anti-AFK", module.AntiAfkStatus .. " · responses: " .. module.IdleResets)
    end})
    local function reduce(effect)
        if module.EffectsReduced and (effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect")
            or effect:IsA("DepthOfFieldEffect") or effect:IsA("BlurEffect")) then
            if effects[effect]==nil then effects[effect]=effect.Enabled end
            effect.Enabled=false
        end
    end
    local function restoreEffects()
        for effect,value in pairs(effects)do if effect.Parent and not effect.Enabled then effect.Enabled=value end end
        table.clear(effects)
    end
    context.Tab.Raw:CreateSection({name="RENDERING"})
    local reduced=context.Tab:AddToggle("BloxSenseReducedEffects",{Title="Reduce post effects",Description="Disable bloom, blur, depth of field and sun rays.",Default=false})
    reduced:OnChanged(function()
        module.EffectsReduced=reduced.Value
        if reduced.Value then
            for _,effect in ipairs(lighting:GetDescendants())do reduce(effect)end
            if workspace.CurrentCamera then for _,effect in ipairs(workspace.CurrentCamera:GetDescendants())do reduce(effect)end end
        else restoreEffects()end
    end)
    table.insert(connections,lighting.DescendantAdded:Connect(reduce))
    local cameraEffects
    local function watchEffects()
        if cameraEffects then cameraEffects:Disconnect()end
        local cam=workspace.CurrentCamera
        if cam then
            for _,effect in ipairs(cam:GetDescendants())do reduce(effect)end
            cameraEffects=cam.DescendantAdded:Connect(reduce)
        end
    end
    table.insert(connections,workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchEffects));watchEffects()
    local gui=Instance.new("ScreenGui");gui.Name="BloxSensePerformance";gui.ResetOnSpawn=false;gui.DisplayOrder=80;gui.Enabled=false;gui.Parent=player.PlayerGui
    local label=Instance.new("TextLabel");label.Name="Counter";label.AnchorPoint=Vector2.new(1,0);label.Position=UDim2.new(1,-16,0,12)
    label.Size=UDim2.fromOffset(170,28);label.BackgroundColor3=THEME.Box;label.BackgroundTransparency=0.15;label.BorderSizePixel=0
    label.TextColor3=THEME.Text;label.Font=THEME.Font;label.TextSize=12;label.Parent=gui
    Instance.new("UICorner",label).CornerRadius=UDim.new(0,7)
    local badge=context.Tab:AddToggle("BloxSensePerformance",{Title="FPS and ping counter",Default=false})
    badge:OnChanged(function()gui.Enabled=badge.Value end)
    local elapsed,frames=0,0
    local binding="BloxSenseCameraQoL"
    run:BindToRenderStep(binding,Enum.RenderPriority.Last.Value,function(dt)
        elapsed+=dt;frames+=1
        if elapsed>=0.5 then
            if gui.Enabled then label.Text=string.format("%d FPS  ·  %s ms",math.floor(frames/elapsed+0.5),tostring(player:GetAttribute("Ping") or "—"))end
            elapsed,frames=0,0
        end
    end)
    function module:Destroy()
        module.AntiAfk, module.CustomFov = false, false
        if cameraController.updateCameraFOV == fovWrapper then
            cameraController.updateCameraFOV = originalFov
            gameCall(originalFov, requestedFov)
        end
        run:UnbindFromRenderStep(binding);restoreEffects()
        for _,connection in ipairs(connections)do connection:Disconnect()end
        if cameraEffects then cameraEffects:Disconnect()end
        gui:Destroy()
    end
    return module
end
end)()

