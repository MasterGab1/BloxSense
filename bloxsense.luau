    function module:Update()
        if not self.Enabled then return end
        self:RefreshKnifeUI()
        local item = inventory.peekCurrentEquippedForMovement()
        local equipped = item and item.Name or getEquippedName()
        if knifeSwap and (item ~= knifeSwap.item or item.IsDestroyed or item.Viewmodel ~= knifeSwap.replacement) then
            self:Restore()
        end
        local model = item and item.Viewmodel and item.Viewmodel.Model or getViewmodel(equipped)
        if equipped ~= lastEquipped then lastEquipped = equipped; markEquipped(equipped) end
        if not model or not model.Parent or not equipped then
            if currentModel then self:Restore() end
            refreshStatus(self.KnifeOverride and "Knife saved · equip after spawning" or "Equip a weapon to preview")
            return
        end
        local weapon, skin = self:ResolveTarget(model, equipped)
        if not weapon then
            if currentModel then self:Restore() end
            refreshStatus("Holding " .. equipped .. " · choose a finish")
            return
        end
        if KNIVES[equipped] and KNIVES[weapon] then
            if not knifeSwap or currentKey ~= weapon .. "|" .. skin or knifeSwap.replacement.Model ~= model then
                self:ApplyKnifeModel(model, weapon, skin)
            end
        else
            local key = model:GetFullName() .. "|" .. weapon .. "|" .. skin
            local refresh = currentModel ~= model or currentKey ~= key
            if not refresh then
                for part, surface in pairs(replacements) do if part.Parent and surface.Parent ~= part then refresh = true; break end end
            end
            if refresh then self:ApplyToModel(model, weapon, skin) end
        end
        refreshStatus()
    end
    function module:SetEnabled(enabled)
