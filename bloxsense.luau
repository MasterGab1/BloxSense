local function updateESP()
    local localCharacter = player.Character
    local camera = workspace.CurrentCamera
    local spectating = player:GetAttribute("IsSpectating") == true
        or not localCharacter or localCharacter:GetAttribute("Dead") == true
    local active = espEnabled and (not spectating or espOptions.WhileSpectating)
    if espOptions.Mode == "Hold" then
        active = active and UserInputService:GetFocusedTextBox() == nil
            and (Window.hidden or Window.minimised) and UserInputService:IsKeyDown(espOptions.Key)
    end
    if not active or not camera then
        for _, data in pairs(espObjects) do data.bill.Enabled = false; data.highlight.Enabled = false end
        return
    end
    local viewedPlayer
    if spectating and spectateController and type(spectateController.GetPlayer) == "function" then
        local ok, target = gameCall(spectateController.GetPlayer)
        if ok then viewedPlayer = target end
    end
    local subject = camera.CameraSubject
    local origin = camera.CFrame.Position
    local ownTeam = player:GetAttribute("Team") or (player.Team and player.Team.Name)
    local seen = {}
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer == player or otherPlayer == viewedPlayer then continue end
        local character = otherPlayer.Character
        local root = getRoot(character)
        if not root or not character:IsDescendantOf(workspace) then continue end
        if spectating and subject and subject:IsDescendantOf(character) then continue end
        local otherTeam = otherPlayer:GetAttribute("Team") or (otherPlayer.Team and otherPlayer.Team.Name)
        if espOptions.EnemiesOnly and (not ownTeam or otherTeam == ownTeam) then continue end
        local health, maxHealth = getHealth(character)
        if character:GetAttribute("Dead") == true or (health and health <= 0) then continue end
        seen[otherPlayer] = true
        local data = espObjects[otherPlayer]
        if data and (data.character ~= character or data.root ~= root or not data.bill.Parent or not data.highlight.Parent) then
            removeESP(otherPlayer); data = nil
        end
        data = data or createESP(otherPlayer, character, root)
        local color = getTeamColor(otherPlayer)
        local distance = (root.Position - origin).Magnitude
        local visible = distance <= espMaxDist
        data.bill.MaxDistance = espMaxDist
        data.bill.AlwaysOnTop = espOptions.ThroughWalls
        data.bill.Enabled = visible
        data.highlight.Enabled = visible and (espOptions.Chams or espOptions.Outline)
        data.highlight.FillColor = color
        data.highlight.OutlineColor = color
        data.highlight.FillTransparency = espOptions.Chams and (1 - espOptions.FillOpacity / 100) or 1
        data.highlight.OutlineTransparency = espOptions.Outline and 0 or 1
        data.highlight.DepthMode = espOptions.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
        if not visible then continue end
        data.nameLabel.TextColor3 = color
        data.nameLabel.Visible = espOptions.Names
        data.nameLabel.Text = otherPlayer.DisplayName
        data.distanceLabel.Visible = espOptions.Distance
        data.distanceLabel.Text = math.floor(distance) .. " studs"
        data.healthBg.Visible = espOptions.Health and health ~= nil and maxHealth ~= nil and maxHealth > 0
        if data.healthBg.Visible then
            local fraction = math.clamp(health / maxHealth, 0, 1)
            data.healthBar.Size = UDim2.new(fraction, 0, 1, 0)
            data.healthBar.BackgroundColor3 = Color3.fromRGB(235, 65, 65):Lerp(Color3.fromRGB(70, 220, 120), fraction)
        end
        local weapon, icon = "", ""
        if espOptions.Weapons then weapon, icon = weaponInfo(otherPlayer) end
        data.weaponLabel.Text = weapon
        data.weaponLabel.Visible = espOptions.Weapons and weapon ~= ""
        data.weaponIcon.Image = icon
        data.weaponIcon.Visible = espOptions.Weapons and icon ~= ""
    end
    for otherPlayer in pairs(espObjects) do
        if not seen[otherPlayer] then removeESP(otherPlayer) end
    end
end

local function setESPEnabled(enabled)
    if cleaned then return end
    espEnabled = enabled == true
    if updateConnection then updateConnection:Disconnect(); updateConnection = nil end
    clearESP()
    if not espEnabled then return end
    updateESP()
    local elapsed = 0
    updateConnection = RunService.Heartbeat:Connect(function(deltaTime)
        elapsed += deltaTime
        if elapsed < 0.1 then return end
        elapsed = 0
        updateESP()
    end)
end

