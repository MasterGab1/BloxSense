    local savePath = "BloxSense/skins-" .. player.UserId .. ".json"
    local loadedEnabled = false
    function module:LoadSelections()
        if type(readfile) ~= "function" or type(isfile) ~= "function" then return false end
        for _, path in ipairs({savePath, savePath .. ".bak"}) do
            local ok, data = pcall(function()
                if not isfile(path) then return nil end
                return http:JSONDecode(readfile(path))
            end)
            if ok and type(data) == "table" and data.Version == 1 and type(data.Selections) == "table" then
                self.Selections = {}
                for weapon, skin in pairs(data.Selections) do
                    local folder = type(weapon) == "string" and skinsFolder:FindFirstChild(weapon)
                    if folder and type(skin) == "string" and folder:FindFirstChild(skin) then
                        self.Selections[weapon] = skin
                    end
                end
                local knife = data.KnifeOverride
                self.KnifeOverride = nil
                if type(knife) == "table" and type(knife.Weapon) == "string" and KNIVES[knife.Weapon]
                    and self.Selections[knife.Weapon] == knife.Skin then
                    self.KnifeOverride = {Weapon = knife.Weapon, Skin = knife.Skin}
                end
                loadedEnabled = data.Enabled == true
                return true
            end
        end
        return false
    end
    function module:SaveSelections()
        local ok, err = pcall(function()
            assert(type(writefile) == "function" and type(readfile) == "function", "File saving unavailable")
            if type(makefolder) == "function" then
                if type(isfolder) ~= "function" or not isfolder("BloxSense") then makefolder("BloxSense") end
            end
            local encoded = http:JSONEncode({Version = 1, Enabled = self.Enabled,
                Selections = self.Selections, KnifeOverride = self.KnifeOverride})
            if type(isfile) == "function" and isfile(savePath) then
                local old = readfile(savePath)
                local valid, data = pcall(http.JSONDecode, http, old)
                if valid and type(data) == "table" and data.Version == 1 then writefile(savePath .. ".bak", old) end
            end
            writefile(savePath, encoded)
            assert(readfile(savePath) == encoded, "Saved file verification failed")
        end)
        self.SaveError = not ok and tostring(err) or nil
        if not ok then context.Notify("Skins were not saved", self.SaveError) end
        return ok
    end
    module:LoadSelections()
    local PART_ALIAS = { CameraModel6 = "Blade", Blade = "CameraModel6", CameraModel5 = "Handle" }
    local RARITY_COLORS = { Stock = Color3.fromRGB(150,150,150), Consumer = Color3.fromRGB(160,160,160), Industrial = Color3.fromRGB(120,160,230), ["Mil-Spec"] = Color3.fromRGB(80,140,255), Restricted = Color3.fromRGB(160,90,255), Classified = Color3.fromRGB(220,80,220), Covert = Color3.fromRGB(235,60,60), Rare = Color3.fromRGB(255,200,60), Purple = Color3.fromRGB(160,90,255), Red = Color3.fromRGB(235,60,60) }
    local RARITY_NAMES = { Stock = "Stock", Consumer = "Consumer", Industrial = "Industrial", ["Mil-Spec"] = "Mil-Spec", Restricted = "Restricted", Classified = "Classified", Covert = "Covert", Rare = "Rare", Purple = "Restricted", Red = "Covert" }
