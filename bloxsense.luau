Modules["flash"] = (function()
-- Precise flash scaler built on the game's own FlashEffect implementation:
-- it tweens PlayerGui "FlashbangEffect"/"FlashOverlay" (BackgroundTransparency)
-- and Lighting "FlashbangColorCorrection" (Brightness/Saturation), plus a
-- "FlashScreenshot"/"ScreenshotImage" for long flashes. Every Heartbeat we
-- rescale the tween's current values by strength s:
--   overlay:  1 - (1 - current) * s
--   CC:       current * s (sign-preserving for negative Saturation)
-- 100% = untouched, 0% = fully immune. Never destroys game instances, so
-- the game's own driver/cleanup state machine keeps working error-free.
return function(context)
    local players = game:GetService("Players")
    local lighting = game:GetService("Lighting")
    local run = game:GetService("RunService")
    local player = players.LocalPlayer
    local module = { Enabled = false, Strength = 1 }
    local connection
    local function overlay()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local g = pg and pg:FindFirstChild("FlashbangEffect")
        return g and g:FindFirstChild("FlashOverlay") or nil
    end
    local function cc()
        return lighting:FindFirstChild("FlashbangColorCorrection")
    end
    local function shot()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local g = pg and pg:FindFirstChild("FlashScreenshot")
        return g and g:FindFirstChild("ScreenshotImage") or nil
    end
    local function apply()
        local s = math.clamp(module.Strength, 0, 1)
        if s >= 0.999 then return end
        local o = overlay()
        if o then
            local cur = o.BackgroundTransparency
            local want = 1 - (1 - cur) * s
            if math.abs(want - cur) > 0.001 then
                o.BackgroundTransparency = want
            end
        end
        local c = cc()
        if c then
            local wb, ws = c.Brightness * s, c.Saturation * s
            if math.abs(wb - c.Brightness) > 0.001 then c.Brightness = wb end
            if math.abs(ws - c.Saturation) > 0.001 then c.Saturation = ws end
        end
        local im = shot()
        if im then
            local cur = im.ImageTransparency
            local want = 1 - (1 - cur) * s
            if math.abs(want - cur) > 0.001 then im.ImageTransparency = want end
        end
    end
    local function tick()
        if not module.Enabled or context.IsDestroyed() then return end
        apply()
    end
    function module:SetEnabled(enabled)
        self.Enabled = enabled == true
        if connection then connection:Disconnect(); connection = nil end
        if not self.Enabled then return end
        context.Notify("Flash scaler", "Scaling FlashOverlay + ColorCorrection (0% = immune).")
        connection = run.Heartbeat:Connect(function()
            tick()
        end)
    end
    local toggle = context.Tab:AddToggle("BloxSenseFlash", {
        Title = "Flash scaler", Description = "Scale the flashbang white-out. 0% = immune.", Default = false,
    })
    module.Toggle = toggle
    toggle:OnChanged(function() module:SetEnabled(toggle.Value) end)
    context.Tab:AddSlider("BloxSenseFlashStrength", {
        Title = "Flash strength %", Default = 100, Min = 0, Max = 100, Rounding = 0,
        Callback = function(value) module.Strength = value / 100 end,
    })
    function module:Destroy()
        self:SetEnabled(false)
    end
    return module
end
end)()

Modules["skins"] = (function()
-- Single-tab skin browser with local cosmetic viewmodel and UI updates.
-- Knife selection equips the existing melee slot, then replaces its presentation.
return function(context)
    local storage = game:GetService("ReplicatedStorage")
    local http = game:GetService("HttpService")
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    local run = game:GetService("RunService")
    local skinsFolder = storage.Assets.Skins
    local library = require(storage.Database.Components.Libraries.Skins)
    local module = { Enabled = false, Selections = {}, KnifeOverride = nil, AppliedParts = 0, Status = "Idle", Revision = 0 }
    local snapshots, replacements = {}, {}
    local connection, currentModel, currentKey, lastEquipped
    local knifeSwap = nil
    local inventory = require(storage.Controllers.InventoryController)
    local viewmodelClass = require(storage.Classes.WeaponComponent.Classes.Viewmodel)
    local uiSnapshots = {}
    local refreshStatus, markEquipped
    local function child(root, ...)
        for _, name in ipairs({...}) do root = root and root:FindFirstChild(name) end
        return root
    end
    local function setUIProperty(object, property, value)
        if not object or object[property] == value then return end
        uiSnapshots[object] = uiSnapshots[object] or {}
        local saved = uiSnapshots[object][property]
        if not saved then saved = {original = object[property]}; uiSnapshots[object][property] = saved
        elseif object[property] ~= saved.applied then saved.original = object[property] end
        saved.applied = value
        object[property] = value
    end
