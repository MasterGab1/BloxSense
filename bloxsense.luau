    local function clearKnifeSwap()
        local saved = knifeSwap
        knifeSwap = nil
        if not saved then return end
        local item, old, replacement = saved.item, saved.old, saved.replacement
        if item.Viewmodel == replacement then item.Viewmodel = old end
        if not replacement.IsDestroyed then gameCall(replacement.destroy, replacement) end
        if item.IsDestroyed then
            if not old.IsDestroyed then gameCall(old.destroy, old) end
        elseif item.Viewmodel == old and not old.IsDestroyed then
            if inventory.peekCurrentEquippedForMovement() == item then
                gameCall(old.equip, old, false)
            else gameCall(old.unequip, old) end
        end
    end
    function module:Restore()
        clearKnifeSwap()
        for part, saved in pairs(snapshots) do
            local replacement = replacements[part]
            if replacement then replacement:Destroy() end
            if part.Parent and not part:FindFirstChildOfClass("SurfaceAppearance") then
                if saved then saved.Parent = part end
            elseif saved then saved:Destroy() end
        end
        snapshots, replacements = {}, {}
        currentModel, currentKey = nil, nil
        self.AppliedParts = 0
    end
    function module:GetTextureFolder(weapon, skin)
        local weaponFolder = skinsFolder:FindFirstChild(weapon)
        local skinFolder = weaponFolder and weaponFolder:FindFirstChild(skin)
        if not skinFolder then return nil end
        for _, view in ipairs({ "Camera", "Character" }) do
            local viewFolder = skinFolder:FindFirstChild(view)
            if viewFolder then
                for _, wear in ipairs({ "Factory New", "Minimal Wear", "Field-Tested", "Well-Worn", "Battle-Scarred" }) do
                    local folder = viewFolder:FindFirstChild(wear)
                    if folder and #folder:GetChildren() > 0 then return folder end
                end
                local any = viewFolder:GetChildren()[1]
                if any then return any end
            end
        end
        return nil
    end
    function module:GetAppearances(weapon, skin)
        local folder = self:GetTextureFolder(weapon, skin)
        if not folder then return nil end
        local appearances = {}
        for _, surface in ipairs(folder:GetChildren()) do
            if surface:IsA("SurfaceAppearance") then appearances[surface.Name] = surface end
        end
        return appearances
    end
    function module:PaintParts(parts, appearances)
        local count = 0
        for _, part in ipairs(parts) do
            if part:IsA("MeshPart") and part.Parent then
                local surface = appearances[part.Name]
                if not surface and PART_ALIAS[part.Name] then surface = appearances[PART_ALIAS[part.Name]] end
                if surface then
                    local old = part:FindFirstChildOfClass("SurfaceAppearance")
                    snapshots[part] = old and old:Clone() or false
                    if old then old:Destroy() end
                    local replacement = surface:Clone()
                    replacement.Parent = part
                    replacements[part] = replacement
                    count += 1
                end
            end
        end
        return count
    end
    function module:ApplyToModel(model, weapon, skin)
        self:Restore()
        local appearances = self:GetAppearances(weapon, skin)
        if not appearances then self.Status = "No textures: " .. weapon .. " | " .. skin; return 0 end
        local parts = {}
        for _, part in ipairs((model:FindFirstChild("Weapon") or model):GetDescendants()) do
            if part:IsA("MeshPart") then table.insert(parts, part) end
        end
        self.AppliedParts = self:PaintParts(parts, appearances)
        currentModel = model
        currentKey = model:GetFullName() .. "|" .. weapon .. "|" .. skin
        self.Status = "Holding " .. model.Name .. " → " .. weapon .. " | " .. skin .. " (" .. self.AppliedParts .. " parts)"
        return self.AppliedParts
    end
    -- Real knife swap: hide the held knife's meshes (joints stay live) and seat
    -- the requested knife's meshes on the same grip joint. The model comes
    -- straight from the game's own weapon templates, so any knife works with
    -- no ownership needed; the finish is painted on afterwards.
    function module:ApplyKnifeModel(model, weapon, skin)
        local revision = self.Revision
        self:Restore()
        local item = inventory.peekCurrentEquippedForMovement()
        if not item or not KNIVES[item.Name] or not item.Viewmodel then
            self.Status = "Waiting for your melee slot"
            return false
        end
        -- Construct the complete rig through the game: matching joints, sound,
        -- camera animations and gloves. Keep the real inventory item intact.
        local cosmetic = table.clone(item)
        cosmetic.Name, cosmetic.Skin, cosmetic.Float = weapon, skin, 0
        cosmetic.ViewmodelCameraWeapon, cosmetic.ViewmodelHideWeaponGeometry = weapon, false
        cosmetic.StatTrack, cosmetic.NameTag, cosmetic.Charm, cosmetic.Stickers = nil, nil, nil, {}
        local ok, replacement = gameCall(viewmodelClass.new, cosmetic, weapon, skin)
        if not ok or not replacement or not replacement.Model then
            self.Status = "Knife could not load: " .. tostring(replacement)
            return false
        end
        if not self.Enabled or revision ~= self.Revision or inventory.peekCurrentEquippedForMovement() ~= item then
            gameCall(replacement.destroy, replacement)
            return false
        end
        local old = item.Viewmodel
        old:unequip()
        item.Viewmodel = replacement
        knifeSwap = {item = item, old = old, replacement = replacement}
        local equipped, err = gameCall(replacement.equip, replacement, false)
        if not equipped then clearKnifeSwap(); self.Status = tostring(err); return false end
        currentModel = replacement.Model
        currentKey = weapon .. "|" .. skin
        self.AppliedParts = 0
        for _,part in ipairs(replacement.Model.Weapon:GetDescendants()) do
            if part:IsA("MeshPart") then self.AppliedParts += 1 end
        end
        self.Status = weapon .. " | " .. skin
        return true
    end
    function module:EquipKnife()
        local slot = inventory.getInventorySlot(3)
        if not slot then return false end
        for index, item in ipairs(slot._items or {}) do
            if KNIVES[item.Name] then
                if inventory.peekCurrentEquippedForMovement() ~= item then
                    local ok, err = gameCall(inventory.equip, 3, index)
                    if not ok then error(err) end
                end
                return true
            end
        end
        return false
    end
