local hookState=env.BloxSenseAssassinHook
activateAimHook=function()
    if not S.Aim and not S.Expand then
        if hookState and hookState.Resolve==rewriteThrow then hookState.Resolve=nil;hookState.Remote=nil end
        preparedThrow=nil;S.HookStatus="Available on demand"
        return
    end
    if not hookState then
        hookState={Resolve=nil,Remote=nil};env.BloxSenseAssassinHook=hookState
    end
    if not hookState.Installed and type(hookmetamethod)=="function" and type(getnamecallmethod)=="function" then
        local previous
        local function dispatch(self,...)
            -- The common path forwards directly; only normal knife throws are inspected.
            if not hookState.Resolve or self~=hookState.Remote or getnamecallmethod()~="FireServer"
                or (type(checkcaller)=="function" and checkcaller()) then return previous(self,...) end
            local args=table.pack(...)
            local ok,point=pcall(hookState.Resolve,args[1])
            if ok and typeof(point)=="Vector3"then args[1]=point end
            return previous(self,table.unpack(args,1,args.n))
        end
        local ok,result=pcall(function()return hookmetamethod(game,"__namecall",type(newcclosure)=="function" and newcclosure(dispatch) or dispatch)end)
        if ok then previous=result;hookState.Installed=true else hookState.Error=tostring(result)end
    end
    if hookState.Installed then
        hookState.Remote=RS.Remotes.ThrowKnife;hookState.Resolve=rewriteThrow;S.HookStatus="Ready"
    else S.HookStatus="Unavailable in this executor" end
end
