adapters.bloxstrike = function()
local Modules = {}

-- Game constructors lazily require ordinary modules. Run those calls at the
-- normal game script identity, then restore the caller even when they fail.
local function gameCall(fn, ...)
    local previous
    if type(getthreadidentity) == "function" and type(setthreadidentity) == "function" then
        previous = getthreadidentity()
        setthreadidentity(2)
    end
    local result = table.pack(pcall(fn, ...))
    if previous then setthreadidentity(previous) end
    return table.unpack(result, 1, result.n)
end

local RAYFIELD_URL = "https://sirius.menu/gen2"
local Rayfield, loadError, finished
task.spawn(function()
    local ok, result = pcall(function() return loadstring(game:HttpGet(RAYFIELD_URL))() end)
    if ok then Rayfield = result else loadError = result end
    finished = true
end)
local deadline = os.clock() + 25
while not finished and os.clock() < deadline do task.wait(0.1) end
if type(Rayfield) ~= "table" or type(Rayfield.CreateWindow) ~= "function" then
    warn("BloxSense: Rayfield could not load: " .. tostring(loadError or "timeout"))
    return
end

-- Rayfield Gen2 adapter. Programmatic changes call feature callbacks exactly once.
local function wrapTab(tab)
    local wrapper = {Raw = tab}
    function wrapper:AddToggle(id, opts)
        local onChanged: (any) -> () = function(_value) end
        local control = {Value = opts.Default == true}
        control._el = tab:CreateToggle({name = opts.Title, description = opts.Description,
            flag = id, value = control.Value, callback = function(value)
                control.Value = value
                onChanged(value)
            end})
        function control:OnChanged(fn) onChanged = fn end
        function control:SetValue(value)
            self.Value = value == true
            self._el:Set(self.Value, true)
            onChanged(self.Value)
        end
        return control
    end
    function wrapper:AddSlider(id, opts)
        return tab:CreateSlider({name = opts.Title, description = opts.Description, flag = id,
            range = {opts.Min, opts.Max}, increment = opts.Rounding == 0 and 1 or 0.1,
            value = opts.Default, callback = opts.Callback})
    end
    function wrapper:AddDropdown(id, opts)
        local onChanged: (any) -> () = function(_value) end
        local control = {Value = table.clone(opts.Default or {})}
        control._el = tab:CreateDropdown({name = opts.Title, flag = id, options = opts.Values,
            multiSelect = true, value = control.Value, callback = function(value)
                control.Value = value
                onChanged(value)
            end})
        function control:OnChanged(fn) onChanged = fn; fn(self.Value) end
        function control:SetValue(value) self._el:Set(value) end
        return control
    end
    function wrapper:AddButton(opts)
        return tab:CreateButton({name = opts.Title, description = opts.Description, callback = opts.Callback})
    end
    function wrapper:AddParagraph(opts)
        local element = tab:CreateText({name = opts.Title, text = opts.Content or ""})
        return {SetDesc = function(_, text) element:Set(text) end, SetTitle = function(_, text) element:SetTitle(text) end}
    end
    function wrapper:AddKeybind(id, opts)
        local onChanged: (any) -> () = function(_value) end
        local control = {Value = opts.Default or "L"}
        control._el = tab:CreateKeybind({name = opts.Title, description = opts.Description,
            flag = id, value = control.Value, isMenuToggle = id == "BloxSenseMenuKey",
            onChanged = function(key)
                control.Value = key.Name
                onChanged(control.Value)
            end})
        function control:OnChanged(fn) onChanged = fn end
        function control:SetValue(value) self._el:Set(value) end
        return control
    end
    function wrapper:AddInput(id, opts)
        return tab:CreateInput({name = opts.Title, flag = id, value = opts.Default,
            placeholder = opts.Placeholder, clearOnFocus = false, callback = opts.Callback})
    end
    return wrapper
end

