local hubBranding=(function()
-- The builders embed the supplied PNG verbatim. No remote image host is needed.
local imageData=""
local assetPath="BloxSense/assets/logo-ce8b534ecdb8.png"
local function logoAsset()
    local customAsset=getcustomasset or getsynasset
    if type(customAsset)~="function" or type(writefile)~="function" then return nil end
    local ok,result=pcall(function()
        if type(makefolder)=="function" then
            pcall(makefolder,"BloxSense");pcall(makefolder,"BloxSense/assets")
        end
        if type(isfile)~="function" or not isfile(assetPath) then
            local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local lookup={};for i=1,#alphabet do lookup[string.byte(alphabet,i)]=i-1 end
            local bytes=table.create(math.ceil(#imageData/4))
            for i=1,#imageData,4 do
                local a,b,c,d=string.byte(imageData,i,i+3)
                local n=lookup[a]*262144+lookup[b]*4096+(lookup[c] or 0)*64+(lookup[d] or 0)
                local first=math.floor(n/65536)%256
                local second=math.floor(n/256)%256
                local third=n%256
                bytes[#bytes+1]=if c==61 then string.char(first) elseif d==61 then string.char(first,second) else string.char(first,second,third)
            end
            writefile(assetPath,table.concat(bytes))
        end
        return customAsset(assetPath)
    end)
    if ok and type(result)=="string" and result~="" then return result end
    warn("BloxSense: custom logo could not load; showing the letter mark.")
    return nil
end

return {Logo=logoAsset,DrawIcon=function(window,tab)
    local native=tab.topbarItemIcon
    if not native then return end
    -- Keep the native icon as an animation/layout anchor; draw actual geometry inside it.
    native.Image=""
    local root=Instance.new("Frame")
    root.Name="BloxSenseIcon";root.BackgroundTransparency=1;root.ZIndex=12
    root.Size=UDim2.fromOffset(22,22);root.AnchorPoint=Vector2.new(0.5,0.5)
    root.Position=UDim2.fromScale(0.5,0.5);root.Parent=native
    local parts={}
    local function segment(x1,y1,x2,y2)
        local dx,dy=x2-x1,y2-y1
        local frame=Instance.new("Frame")
        frame.BorderSizePixel=0;frame.AnchorPoint=Vector2.new(0.5,0.5)
        frame.Position=UDim2.fromOffset((x1+x2)/2,(y1+y2)/2)
        frame.Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),2)
        frame.Rotation=math.deg(math.atan2(dy,dx));frame.Parent=root
        local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(1,0);corner.Parent=frame
        parts[#parts+1]=frame
    end
    local function path(points,closed)
        for i=1,#points-1 do segment(points[i][1],points[i][2],points[i+1][1],points[i+1][2])end
        if closed then segment(points[#points][1],points[#points][2],points[1][1],points[1][2])end
    end
    local function circle(x,y,r)
        local points={}
        for i=0,19 do local a=i*math.pi/10;points[#points+1]={x+math.cos(a)*r,y+math.sin(a)*r}end
        path(points,true)
    end
    local name=tab.name
    if name=="Hub" then
        path({{2,10},{11,2},{20,10}});path({{5,9},{5,20},{9,20},{9,14},{13,14},{13,20},{17,20},{17,9}})
    elseif name=="Visuals" then
        path({{1,11},{5,6},{11,4},{17,6},{21,11},{17,16},{11,18},{5,16}},true);circle(11,11,3)
    elseif name=="Targets" then
        circle(11,11,7);circle(11,11,2);segment(11,1,11,6);segment(11,16,11,21);segment(1,11,6,11);segment(16,11,21,11)
    elseif name=="Aim" then
