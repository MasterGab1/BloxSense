local function updateThreats(now)
    local own=character(Player);local root=own and own:FindFirstChild("HumanoidRootPart")
    for id,entry in pairs(projectiles)do
        if now>entry.Expires then projectiles[id]=nil;continue end
        local host=workspace:FindFirstChild("KnifeHost");local knife=host and host:FindFirstChild(id)
        if knife and knife:IsA("BasePart")then
            local speed=knife.AssemblyLinearVelocity.Magnitude
            if not knife.Anchored and speed>100 and speed<600 then measuredSpeed=measuredSpeed and measuredSpeed*0.9+speed*0.1 or speed end
            if entry.Owner~=Player and root and entry.Previous and now-entry.Time>0.001 then
                local velocity=(knife.Position-entry.Previous)/(now-entry.Time)
                local delta=root.Position-knife.Position
                local time=velocity:Dot(delta)/math.max(velocity:Dot(velocity),0.001)
                if time>0 and time<1.2 and (delta-velocity*time).Magnitude<7 then
                    threats[entry.Owner]=now+1.5
                    if S.HUD and now-(alertTimes[entry.Owner] or -math.huge)>5 then
                        alertTimes[entry.Owner]=now
                        intelToast("Incoming knife",entry.Owner.DisplayName,entry.Owner)
                    end
                end
            end
            entry.Previous=knife.Position;entry.Time=now
        end
    end
    for p,untilTime in pairs(threats)do if now>untilTime then threats[p]=nil end end
end
local function updateKnifeESP(camera)
    local host=workspace:FindFirstChild("KnifeHost")
    local seen={}
    if S.KnifeESP and host then
        for _,knife in ipairs(host:GetChildren())do
            if not knife:IsA("BasePart")then continue end
            local distance=(knife.Position-camera.CFrame.Position).Magnitude
            if distance>S.KnifeDistance then continue end
            local entry=projectiles[tostring(knife.Name)]
            local owner=entry and entry.Owner
            local color=accent
            if owner==Player then color=Color3.fromRGB(200,200,200)elseif owner then local _,roleColor=role(owner);color=roleColor end
            local drawing=knifeDrawings[knife]
            if not drawing then
                local billboard=make("BillboardGui",{Name="KnifeESP",Adornee=knife,AlwaysOnTop=true,
                    Size=UDim2.fromOffset(180,38),StudsOffsetWorldSpace=Vector3.new(0,0.8,0),MaxDistance=S.KnifeDistance},gui)
                local title=label(billboard,{Size=UDim2.fromScale(1,1),TextSize=11})
                local outline=make("Highlight",{Adornee=knife,FillTransparency=0.65,OutlineTransparency=0.15,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop},gui)
                drawing={Billboard=billboard,Label=title,Outline=outline};knifeDrawings[knife]=drawing
            end
            drawing.Billboard.MaxDistance=S.KnifeDistance
            drawing.Label.Text=(knife.Anchored and "LANDED KNIFE" or "THROWN KNIFE").." · "..math.floor(distance).." studs"..
                (S.KnifeOwner and owner and "\n"..owner.DisplayName or "")
            drawing.Label.TextColor3=color;drawing.Outline.FillColor=color;drawing.Outline.OutlineColor=color
            seen[knife]=true
        end
    end
    for knife,drawing in pairs(knifeDrawings)do
        if not seen[knife]then drawing.Billboard:Destroy();drawing.Outline:Destroy();knifeDrawings[knife]=nil end
    end
end
local function step()
    if S.Destroyed then return end
    local camera=workspace.CurrentCamera;if not camera then return end
    local now=os.clock()
    updateThreats(now)
    updateKnifeESP(camera)
    prepareThrow(camera)
    local _,cursor=cursorRay(camera)
    fov.Position=UDim2.fromOffset(cursor.X,cursor.Y);fov.Size=UDim2.fromOffset(S.AimRadius*2,S.AimRadius*2)
    fov.Visible=S.Aim and S.ShowFOV and combatActive()
    for _,p in ipairs(Players:GetPlayers())do
        if p==Player then continue end
        local c=character(p);local d=getDrawing(p)
        d.Box.Visible=false;d.Highlight.Enabled=false
        if regions[p]then regions[p].Visible=false end
        if not c or not alive(p)then continue end
        local root=c:FindFirstChild("HumanoidRootPart")
        local distance=(root.Position-camera.CFrame.Position).Magnitude
        if distance>S.ESPDistance then continue end
        local title,color=role(p)
        local priority=title=="YOUR TARGET" or title=="INCOMING KNIFE"
        if S.ESP and (not S.OnlyPriority or priority)then
            local low,size=bounds(c,camera)
            if low then
                d.Box.Visible=true;d.Box.Position=UDim2.fromOffset(low.X,low.Y);d.Box.Size=UDim2.fromOffset(size.X,size.Y)
                d.Box.BackgroundTransparency=S.Boxes and 0.96 or 1;d.Stroke.Enabled=S.Boxes;d.Stroke.Color=color
                d.Name.Text=S.Names and p.DisplayName or "";d.Tag.Text=S.RoleLabels and title or "";d.Tag.TextColor3=color
                local info={};if S.Distance then table.insert(info,math.floor(distance).." studs")end
                if S.Weapons then table.insert(info,c:FindFirstChild("Knife") and "Knife equipped" or "Unarmed")end
                d.Info.Text=table.concat(info," · ")
                local hum=c:FindFirstChildOfClass("Humanoid");local hp=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
                d.Health.Visible=S.Health;d.Fill.Size=UDim2.fromScale(1,hp);d.Fill.BackgroundColor3=Color3.fromRGB(255*(1-hp),190*hp+40,100)
            end
            d.Highlight.Adornee=c;d.Highlight.Enabled=S.Chams;d.Highlight.FillColor=color;d.Highlight.OutlineColor=color
            d.Highlight.FillTransparency=S.Fill/100
            d.Highlight.DepthMode=S.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
        end
        if S.ShowRegions and allowed(p)then
            local part=c:FindFirstChild(S.RegionPart)
            if part then
                local box=regions[p]
                if not box then box=make("BoxHandleAdornment",{AlwaysOnTop=true,ZIndex=1},gui);regions[p]=box end
                box.Adornee=part;box.Size=part.Size*(S.Expand and S.Scale or 1);box.Color3=color;box.Transparency=1-S.RegionOpacity/100;box.Visible=true
            end
        end
    end
    if S.FovOn then
        if cameraForFov~=camera then restoreFov();cameraForFov=camera;savedFov=camera.FieldOfView end
        if appliedFov and camera.FieldOfView~=appliedFov then savedFov=camera.FieldOfView end
        camera.FieldOfView=S.Fov;appliedFov=S.Fov
    else restoreFov()end

end
