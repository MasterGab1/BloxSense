local columnConnections = {}
local function columns(tab)
    local row = tab:CreateGroup({direction = "row"})
    local left = row:CreateGroup({direction = "column"})
    local right = row:CreateGroup({direction = "column"})
    -- Gen2 columns can host keybind elements but omit the convenience method.
    for _, column in ipairs({left, right}) do
        if not column.CreateKeybind then
            function column:CreateKeybind(options) return self:_add("keybind", options) end
        end
        function column:CreateDropdown(options)
            local element = self:_add("dropdown", options)
            -- Dropdowns in a column still scroll their containing tab page.
            function element:_bringIntoView()
                local page = tab.tabPage
                if page.AbsoluteWindowSize.Y <= 0 then return end
                local canvas = page.CanvasPosition
                local top = self.main.AbsolutePosition.Y - page.AbsolutePosition.Y + canvas.Y
                local overflow = top + self:_openHeight() - canvas.Y - page.AbsoluteWindowSize.Y
                if overflow > 0 then
                    game:GetService("TweenService"):Create(page,
                        TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                        {CanvasPosition = Vector2.new(canvas.X, math.min(canvas.Y + overflow + 8, top))}):Play()
                end
            end
            return element
        end
    end
    left.layout.Padding = UDim.new(0, 6)
    right.layout.Padding = UDim.new(0, 6)
    local function fit()
        local wide = tab.tabPage.AbsoluteSize.X >= 660
        row.direction = wide and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
        row.layout.FillDirection = row.direction
        row.layout.Padding = UDim.new(0, wide and 8 or 14)
        row.layout.VerticalAlignment = Enum.VerticalAlignment.Top
        for _, column in ipairs({left, right}) do
            local flex = column.main:FindFirstChildOfClass("UIFlexItem")
            if flex then flex.FlexMode = wide and Enum.UIFlexMode.Fill or Enum.UIFlexMode.None end
            column.main.Size = wide and UDim2.fromOffset(0, 0) or UDim2.new(1, 0, 0, 0)
        end
    end
    table.insert(columnConnections, tab.tabPage:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
    fit()
    return wrapTab(left), wrapTab(right)
end
