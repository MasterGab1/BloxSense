local savedFov,appliedFov,cameraForFov
local function restoreFov()
    if cameraForFov and appliedFov and cameraForFov.FieldOfView==appliedFov then cameraForFov.FieldOfView=savedFov end
    savedFov,appliedFov,cameraForFov=nil,nil,nil
