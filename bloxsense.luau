Modules["autobhop"] = (function()
return function(context)
    local input = game:GetService("UserInputService")
    local storage = game:GetService("ReplicatedStorage")
    local controller = require(storage.Controllers.CharacterController)
    local characterClass = require(storage.Classes.Character)
    local buttons = require(storage.MovementV2.Buttons)
    local module = {Enabled = false, Pulses = 0, HopKey = Enum.KeyCode.Space, Status = "Off"}
    local lastCharacter, pressed = nil, false
    -- Sample alongside movement commands, before simulation, instead of releasing
    -- a delayed jump on Heartbeat. Repeated edges keep the native landing buffer fed.
    function module:FilterSample(sample, character, held, active)
        if character ~= lastCharacter then lastCharacter = character; pressed = false end
        if not self.Enabled or not held or not active or not character or character.IsDestroyed then
            pressed = false
            self.Status = self.Enabled and "Hold Space" or "Off"
            return sample
        end
        local state = character.MovementState
        if (state and (state.MovementMode == "Ladder" or state.MovementType == "Ladder"))
            or character.IsPlantingBomb then pressed = false; self.Status = "Paused"; return sample end
        if type(sample) ~= "table" or type(sample.Buttons) ~= "number" then return sample end
        pressed = not pressed
        local result = table.clone(sample)
        result.Buttons = buttons.with(sample.Buttons, buttons.Jump, pressed)
        if pressed then self.Pulses += 1 end
        self.Status = "Landing buffer active"
        return result
    end
    local original = characterClass.SampleInput
    assert(type(original) == "function", "Movement input adapter unavailable")
    local wrapper = function(character, ...)
        local sample = original(character, ...)
        if character ~= controller.getCurrentCharacter() then return sample end
        return module:FilterSample(sample, character, input:IsKeyDown(module.HopKey), context.IsGameplayActive())
    end
    characterClass.SampleInput = wrapper
    function module:SetEnabled(enabled)
        self.Enabled = enabled == true
        pressed, lastCharacter = false, nil
        self.Status = self.Enabled and "Hold Space" or "Off"
    end
    local toggle = context.Tab:AddToggle("BloxSenseAutobhop", {
        Title = "Autobhop", Description = "Hold Space. Buffers jumps before landing to reduce extra ground friction.", Default = false,
    })
    toggle:OnChanged(function() module:SetEnabled(toggle.Value) end)
    module.Toggle = toggle
    context.Tab:AddButton({Title = "Bunnyhop status", Callback = function()
        context.Notify("Bunnyhop", module.Status .. " · native speed caps and landing penalties still apply")
    end})
    function module:Destroy()
        self:SetEnabled(false)
        if characterClass.SampleInput == wrapper then characterClass.SampleInput = original end
    end
    return module
end
end)()

Modules["targeting"] = (function()
return function(context)
    local players = game:GetService("Players")
    local storage = game:GetService("ReplicatedStorage")
    local player = players.LocalPlayer
    local raycast = require(storage.Shared.Raycast)
    local getIgnore = require(storage.Components.Common.GetRayIgnore)
    local module = { Radius = 120, MaxDistance = 1000 }
    module.CombatParts = { "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot" }
    module.AllowedParts = { Head = true, UpperTorso = true, LowerTorso = true, HumanoidRootPart = true }
    module.CosmeticMap = { Balaclava = "Head", Vest = "UpperTorso", Belt = "LowerTorso", LeftGlove = "LeftHand", RightGlove = "RightHand" }
    local function team(p) return p:GetAttribute("Team") or (p.Team and p.Team.Name) end
    function module:IsEnemy(p)
        if not p or p == player then return false end
        local ownTeam, otherTeam = team(player), team(p)
        if ownTeam ~= "Counter-Terrorists" and ownTeam ~= "Terrorists" then return false end
        return (otherTeam == "Counter-Terrorists" or otherTeam == "Terrorists") and otherTeam ~= ownTeam
    end
    function module:IsAlive(p)
        local character = p and p.Character
        if not character or not character:IsDescendantOf(workspace) or character:GetAttribute("Dead") == true then return false end
        local health = character:GetAttribute("Health")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if type(health) == "number" then return health > 0 end
        return not humanoid or humanoid.Health > 0
    end
    function module:Cast(origin, direction)
        local ignore = table.clone(getIgnore() or {})
        if player.Character then table.insert(ignore, player.Character) end
        if workspace.CurrentCamera then table.insert(ignore, workspace.CurrentCamera) end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.CollisionGroup = "Bullet"
        local function expanded(limit)
            local hitboxes = context.Modules.hitboxes
            return hitboxes and hitboxes:Cast(origin, direction, limit)
        end
        for _ = 1, 20 do
            params.FilterDescendantsInstances = ignore
            local hit = workspace:Raycast(origin, direction, params)
            if not hit then return expanded(direction.Magnitude) end
            local part = hit.Instance
            local accessory = part:FindFirstAncestorWhichIsA("Accessory")
            if accessory or part:HasTag("CharacterAccessory") or part.Name == "CollisionCapsule" then
                table.insert(ignore, accessory or part)
            else
                return expanded(hit.Distance) or { instance = part, position = hit.Position, normal = hit.Normal, material = hit.Material }
            end
        end
        return nil
    end
    function module:PlayerFromHit(part)
        if not part then return nil end
        for _, p in ipairs(players:GetPlayers()) do
            if p.Character and part:IsDescendantOf(p.Character) then return p end
        end
        return nil
    end
    function module:IsPartAllowed(part)
        if not part then return false end
        if self.AllowedParts[part.Name] then return true end
        local mapped = self.CosmeticMap[part.Name]
        if mapped then return self.AllowedParts[mapped] == true end
        return false
    end
    function module:HitPartFromHit(instance, character)
        if not instance or not character then return nil end
        local cur = instance
        while cur and cur ~= character do
            if cur.Parent == character then return cur end
            cur = cur.Parent
        end
        return nil
    end
    function module:CrosshairEnemy()
        local camera = workspace.CurrentCamera
        if not camera or not context.IsGameplayActive() then return nil end
        local center = camera.ViewportSize * 0.5
        local ray = camera:ViewportPointToRay(center.X, center.Y)
        local hit = self:Cast(ray.Origin, ray.Direction * self.MaxDistance)
        if not hit or not hit.instance then return nil end
        local p = self:PlayerFromHit(hit.instance)
        if not self:IsEnemy(p) or not self:IsAlive(p) then return nil end
        local hitPart = self:HitPartFromHit(hit.instance, p.Character)
        if not hitPart or hitPart.Name == "CameraPart" then return nil end
        if not self:IsPartAllowed(hitPart) then return nil end
        return p, hit
    end
    function module:ClosestEnemy(allowWalls, accept)
        local camera = workspace.CurrentCamera
        if not camera or not context.IsGameplayActive() then return nil end
        local center = camera.ViewportSize * 0.5
        local best, nearest = nil, self.Radius
        local ownCharacter = player.Character
        for _, p in ipairs(players:GetPlayers()) do
            if not self:IsEnemy(p) or not self:IsAlive(p) then continue end
            local character = p.Character
            if not character then continue end
            for partName, allowed in pairs(self.AllowedParts) do
                if not allowed then continue end
                local part = character:FindFirstChild(partName)
                if not part or not part:IsA("BasePart") then continue end
                local position, onScreen = camera:WorldToViewportPoint(part.Position)
                if not onScreen then continue end
                local pixels = (Vector2.new(position.X, position.Y) - center).Magnitude
                local hitboxes = context.Modules.hitboxes
                if hitboxes and hitboxes.Enabled then
                    local ray = camera:ViewportPointToRay(center.X, center.Y)
                    if hitboxes:IntersectPart(part, ray.Origin, ray.Direction * self.MaxDistance) then pixels = 0 end
                end
                if pixels > nearest then continue end
                local offset = part.Position - camera.CFrame.Position
                if offset.Magnitude > self.MaxDistance then continue end
                if not allowWalls then
                    local hit = self:Cast(camera.CFrame.Position, offset)
                    if hit and hit.instance then
                        if ownCharacter and hit.instance:IsDescendantOf(ownCharacter) then
                            -- Your own limbs (especially while jumping) can cross
                            -- the camera ray; self-occlusion must never reject a target.
                        elseif not hit.instance:IsDescendantOf(character) then
                            continue
                        end
                    end
                end
                local candidate = { Player = p, Part = part }
                if not accept or accept(candidate) then
                    nearest = pixels
                    best = candidate
                end
            end
        end
        return best
    end
    return module
end
end)()

Modules["trigger"] = (function()
return function(context)
    local run = game:GetService("RunService")
    local input = game:GetService("UserInputService")
    local storage = game:GetService("ReplicatedStorage")
    local inventory = require(storage.Controllers.InventoryController)
    local gameState = require(storage.Database.Components.GameState)
    local player = game:GetService("Players").LocalPlayer
    local module = { Enabled = false, Delay = 0, Cooldown = 0, Jitter = 0, Clicks = 0, Status = "Off", Mode = "Crosshair" }
    local connection, tracked, trackedWeapon, busy
    local since, lastShot, plannedDelay, generation = 0, 0, 0, 0
    function module:ReadyWeapon()
        local item = inventory.peekCurrentEquippedForMovement()
        if not item or item.IsDestroyed then return nil, "Equip a gun" end
        if not item.Properties or item.Properties.Class ~= "Weapon" or item.Name == "Zeus x27" then
            return nil, "Equip a gun"
        end
        if type(item.shoot) ~= "function" then return nil, "Weapon API unavailable" end
        if type(item.Rounds) ~= "number" or item.Rounds <= 0 then return nil, "Out of ammo" end
        if item.IsReloading then return nil, "Reloading" end
        if item.IsShooting or item.IsAdjustingSuppressor or item.IsChargeFiring then return nil, "Weapon busy" end
        if gameState.GetState() == "Buy Period" then return nil, "Buy period" end
        if player:GetAttribute("IsDefusingBomb") or player:GetAttribute("IsLocallyDefusingBomb") then
            return nil, "Defusing"
        end
        local animation = item.Viewmodel and item.Viewmodel.Animation
        local equip = animation and animation:getAnimation("Equip")
        if not equip then return nil, "Loading weapon" end
        if tick() - (item.WeaponEquippedTick or tick()) < math.max(0.35, equip.Length * 0.925) then
            return nil, "Equipping"
        end
        return item
    end
    function module:AcquireTarget(item)
        if self.Mode == "Aim target" then
            local aim = context.Modules.silentaim
            if not aim or not aim.Enabled then return nil end
            local target = aim:FindShot(item)
            return target and target.Player
        end
        return context.Targeting:CrosshairEnemy()
    end
    function module:Step(now)
        if not self.Enabled then return end
        local reason = context.CombatPauseReason()
        if reason then tracked = nil; self.Status = reason; return end
        if input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            tracked = nil; self.Status = "Manual fire"; return
        end
        local item, unavailable = self:ReadyWeapon()
        if not item then tracked = nil; self.Status = unavailable; return end
        local target = self:AcquireTarget(item)
        if not target then
            tracked = nil
            self.Status = self.Mode == "Aim target" and "Waiting for a reachable silent-aim target" or "Ready · aim at an enemy"
            return
        end
        if target ~= tracked or item ~= trackedWeapon then
            tracked, trackedWeapon, since = target, item, now
            plannedDelay = self.Delay + math.random() * self.Jitter
        end
        self.Status = "Tracking " .. target.Name
        if busy or now - since < plannedDelay or now - lastShot < math.max(self.Cooldown, item.Properties.FireRate or 0) then return end
        local token = generation
        busy = true
        task.spawn(function()
            -- Revalidate after scheduling; never fire an old target after a toggle or equip.
            if token ~= generation or not module.Enabled or context.CombatPauseReason()
                or inventory.peekCurrentEquippedForMovement() ~= item
                or module:AcquireTarget(item) ~= target then
                if token == generation then busy = false end
                return
            end
            lastShot = os.clock()
            module.LastShotAt = lastShot
            local before = item.Rounds
            -- Keep the game's own ammo, fire-rate, reload and equip checks.
            -- A single native shot avoids mouse1click's zero-length press/release.
            local ok, err = gameCall(function()
                if item.Properties.ShootingOptions == "Revolver" then
                    item:shoot("Secondary")
                else
                    item:shoot()
                end
            end)
            if not ok then module.Status = "Fire error: " .. tostring(err)
            elseif item.Rounds and item.Rounds < before then
                module.Clicks += 1
                module.Status = "Fired · " .. module.Clicks
            else module.Status = "Waiting for weapon" end
            if token == generation then busy = false end
        end)
    end
    function module:SetEnabled(value)
        generation += 1
        if connection then connection:Disconnect(); connection = nil end
        self.Enabled = value == true
        tracked, trackedWeapon, busy = nil, nil, false
        since, lastShot = 0, 0
        self.Status = self.Enabled and "Ready" or "Off"
        if self.Enabled then
            connection = run.Heartbeat:Connect(function()
                local ok, err = pcall(self.Step, self, os.clock())
                if not ok then self.Status = "Error: " .. tostring(err) end
            end)
        end
    end
    local firingTab = context.Tab2 or context.Tab
    local toggle = context.Tab:AddToggle("BloxSenseTrigger", { Title = "Automatic fire", Default = false })
    module.Toggle = toggle
    toggle:OnChanged(function() module:SetEnabled(toggle.Value) end)
    firingTab.Raw:CreateDropdown({name = "Trigger targeting", flag = "BloxSenseTriggerMode",
        options = {"Crosshair", "Aim target"}, value = {"Crosshair"}, multiSelect = false,
        description = "Aim target follows silent aim and checks that the shot can reach its target.",
        callback = function(value)
            local mode = type(value) == "table" and value[1] or value
            if mode == "Crosshair" or mode == "Aim target" then module.Mode = mode; tracked = nil end
        end})
    for _,spec in ipairs({ {"Delay",0,0,500}, {"Cooldown",0,0,1000}, {"Jitter",0,0,100} }) do
        local field = spec[1]
        firingTab:AddSlider("BloxSenseTrigger" .. field, {
            Title = "Trigger " .. field:lower() .. " (ms)", Default = spec[2], Min = spec[3], Max = spec[4], Rounding = 0,
            Callback = function(value) module[field] = value / 1000 end,
        })
    end
    firingTab:AddButton({ Title = "Trigger status", Callback = function()
        context.Notify("Trigger", module.Status .. " · confirmed shots: " .. module.Clicks)
    end })
    function module:Destroy() self:SetEnabled(false) end
    return module
end
end)()

Modules["silentaim"] = (function()
return function(context)
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    local storage = game:GetService("ReplicatedStorage")
    local bullet = require(storage.Components.Weapon.Classes.Bullet)
    local raycast = require(storage.Shared.Raycast)
    local getIgnore = require(storage.Components.Common.GetRayIgnore)
    local module = { Enabled = false, ShowFOV = true, Redirects = 0, Wallbang = false }
    local previous, wrapper
    local fovGui, fovCircle
    local function ensureFov()
        if fovGui and fovGui.Parent then return end
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        fovGui = Instance.new("ScreenGui")
        fovGui.Name = "BloxSenseFOV"
        fovGui.ResetOnSpawn = false
        fovGui.IgnoreGuiInset = true
        fovGui.DisplayOrder = 90
        fovGui.Enabled = false
        fovGui.Parent = pg
        fovCircle = Instance.new("Frame")
        fovCircle.Name = "Circle"
        fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
        fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
        fovCircle.BackgroundTransparency = 1
        fovCircle.BorderSizePixel = 0
        fovCircle.Parent = fovGui
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = fovCircle
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5
        stroke.Transparency = 0.15
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Parent = fovCircle
    end
    local function updateFov()
        ensureFov()
        if not fovGui or not fovCircle then return end
        local radius = context.Targeting.Radius or 120
        fovCircle.Size = UDim2.fromOffset(math.max(radius * 2, 2), math.max(radius * 2, 2))
        fovGui.Enabled = module.Enabled and module.ShowFOV
    end
    -- Match the game's material allowances, counting real entry/exit thickness.
    local materialAllowance = {Plastic = 10, SmoothPlastic = 10, Wood = 10,
        WoodPlanks = 10, Cardboard = 10, Glass = 25, Fabric = 25}
    function module:BuildShot(weaponBullet, target, allowWalls)
        local camera = workspace.CurrentCamera
        local character = target and target.Player and target.Player.Character
        if not camera or not character or not target.Part or not target.Part:IsDescendantOf(character) then return nil end
        local properties = weaponBullet and weaponBullet.Properties
        if not properties then return nil end
        local center = camera.ViewportSize * 0.5
        local origin = camera:ViewportPointToRay(center.X, center.Y).Origin
        local offset = target.Part.Position - origin
        local range = properties.Range or 500
        if offset.Magnitude < 0.001 or offset.Magnitude > range then return nil end
        local direction = offset.Unit
        local penetration = math.max(properties.Penetration or 0, 0)
        local ignore = table.clone(getIgnore() or {})
        if player.Character then table.insert(ignore, player.Character) end
        table.insert(ignore, camera)
        local debris = workspace:FindFirstChild("Debris")
        local visualizers = (debris and debris:FindFirstChild("RaycastVisualizers")) or workspace:FindFirstChild("RaycastVisualizers")
        if visualizers then table.insert(ignore, visualizers) end
        local params = RaycastParams.new()
        params.CollisionGroup = "Bullet"
        params.FilterType = Enum.RaycastFilterType.Exclude
        local hits, depths = {}, {}
        local cursor = origin
        local firstDistance
        local function impact(hit, exit)
            table.insert(hits, {Position = hit.Position, Instance = hit.Instance,
                Material = hit.Material.Name, Normal = hit.Normal, Exit = exit})
        end
        for _ = 1, 64 do
            local remaining = range - (cursor - origin).Magnitude
            if remaining <= 0 then return nil end
            params.FilterDescendantsInstances = ignore
            local hit = workspace:Raycast(cursor, direction * remaining, params)
            if not hit then return nil end
            local part = hit.Instance
            local accessory = part:FindFirstAncestorWhichIsA("Accessory")
            if accessory or part:HasTag("CharacterAccessory") or part.Name == "CollisionCapsule" then
                table.insert(ignore, accessory or part)
                continue
            end
            firstDistance = firstDistance or (hit.Position - origin).Magnitude
            impact(hit, false)
            if part:IsDescendantOf(character) then
                local bodyPart = context.Targeting:HitPartFromHit(part, character)
                if not context.Targeting:IsPartAllowed(bodyPart) then return nil end
                return {Origin = origin, Direction = direction, Distance = firstDistance, Hits = hits}
            end
            if not allowWalls or not part:IsA("BasePart") then return nil end
            -- Do not route a bullet through an unrelated player to reach this one.
            if context.Targeting:PlayerFromHit(part) then return nil end
            local exitParams = RaycastParams.new()
            exitParams.CollisionGroup = "Bullet"
            exitParams.FilterType = Enum.RaycastFilterType.Include
            exitParams.FilterDescendantsInstances = {part}
            local probe = hit.Position + direction * (part.Size.Magnitude + 0.01)
            local exitHit = workspace:Raycast(probe, hit.Position - probe, exitParams)
            if not exitHit then return nil end
            local thickness = (exitHit.Position - hit.Position).Magnitude
            local material = part.Parent and part.Parent:HasTag("BreakableDoor") and Enum.Material.Metal or part.Material
            local variant = part.MaterialVariant
            local special = variant == "Sandy Brick" or variant == "IndoorWall"
            local key = special and variant or material.Name
            local allowance = not special and materialAllowance[material.Name] or 0
            allowance = allowance or 0
            if allowance == 0 and workspace:GetAttribute("Map") == "Reactor" then allowance = -1 end
            depths[key] = (depths[key] or 0) + thickness
            if depths[key] > allowance + penetration then return nil end
            if (exitHit.Position - origin).Magnitude >= range then return nil end
            impact(exitHit, true)
            table.insert(ignore, part)
            cursor = exitHit.Position + direction * 0.001
        end
        return nil
    end
    function module:FindShot(weaponBullet)
        local shot
        local target = context.Targeting:ClosestEnemy(self.Wallbang, function(candidate)
            local result = self:BuildShot(weaponBullet, candidate, self.Wallbang)
            if result then shot = result; return true end
            return false
        end)
        return target, shot
    end

    function module:SetEnabled(enabled)
        self.Enabled = enabled == true
        if not self.Enabled then
            if wrapper and bullet._performRaycast == wrapper then bullet._performRaycast = previous end
            updateFov()
            return
        end
        if bullet._performRaycast == wrapper and wrapper then updateFov(); return end
        previous = bullet._performRaycast
        if type(previous) ~= "function" then error("The game's bullet adapter is unavailable.") end
        local original = previous
        wrapper = function(weaponBullet, ...)
            if module.Enabled and context.IsCombatActive() then
                local ok, shot = pcall(function()
                    local _, result = module:FindShot(weaponBullet)
                    return result
                end)
                if ok and shot then module.Redirects += 1; return shot end
            end
            return original(weaponBullet, ...)
        end
        bullet._performRaycast = wrapper
        updateFov()
    end
    local toggle = context.Tab:AddToggle("BloxSenseSilentAim", {
        Title = "Silent aim", Description = "Directs your shots toward a selected body part inside the aim radius.", Default = false,
    })
    module.Toggle = toggle
    toggle:OnChanged(function()
        local ok, err = pcall(function() module:SetEnabled(toggle.Value) end)
        if not ok then
            module.Enabled = false
            context.Notify("Silent aim", tostring(err))
            task.defer(function() if not context.IsDestroyed() then toggle:SetValue(false) end end)
        end
        updateFov()
    end)
    local selectionTab = context.Tab2 or context.Tab
    selectionTab.Raw:CreateSection({name = "SELECTION"})
    selectionTab:AddSlider("BloxSenseAimRadius", {
        Title = "Aim radius (pixels)", Default = 120, Min = 20, Max = 1200, Rounding = 0,
        Callback = function(value) context.Targeting.Radius = value; updateFov() end,
    })
    selectionTab:AddSlider("BloxSenseAimDistance", {Title = "Aim distance (studs)", Default = 1000,
        Min = 50, Max = 2000, Rounding = 0, Callback = function(value) context.Targeting.MaxDistance = value end})
    local wallToggle = context.Tab:AddToggle("BloxSenseWallbang", {
        Title = "Shoot through walls", Description = "Requires silent aim. Selects cover the weapon can penetrate within its range.", Default = false,
    })
    module.WallToggle = wallToggle
    wallToggle:OnChanged(function() module.Wallbang = wallToggle.Value == true end)
    local fovToggle = selectionTab:AddToggle("BloxSenseShowFOV", {
        Title = "Show FOV circle", Description = "Radius visualizer centered on the crosshair.", Default = true,
    })
    fovToggle:OnChanged(function() module.ShowFOV = fovToggle.Value == true; updateFov() end)
    ensureFov()
    updateFov()
    function module:Destroy()
        self:SetEnabled(false)
        if fovGui then fovGui:Destroy() end
        fovGui, fovCircle = nil, nil
    end
    return module
end
end)()

Modules["rotation"] = (function()
return function(context)
    local run = game:GetService("RunService")
    local input = game:GetService("UserInputService")
    local player = game:GetService("Players").LocalPlayer
    local storage = game:GetService("ReplicatedStorage")
    local controller = require(storage.Controllers.CharacterController)
    local inventory = require(storage.Controllers.InventoryController)
    local module = {Enabled = false, Speed = 720, LookDown = true, Pitch = 75,
        PauseShooting = true, Status = "Off", Samples = 0}
    local connection, attached, previousOwn, wrapper
    local phaseStarted = os.clock()
    function module:RotateSample(sample, now)
        if type(sample) ~= "table" or type(sample.LookYaw) ~= "number" or typeof(sample.Move) ~= "Vector2" then return sample end
        local phase = math.rad(((now - phaseStarted) * self.Speed) % 360)
        local yaw = math.atan2(math.sin(sample.LookYaw + phase), math.cos(sample.LookYaw + phase))
        -- Keep the same world-space movement while changing the sampled body yaw.
        local worldMove = CFrame.Angles(0, sample.LookYaw, 0):VectorToWorldSpace(Vector3.new(sample.Move.X, 0, sample.Move.Y))
        local relative = CFrame.Angles(0, yaw, 0):VectorToObjectSpace(worldMove)
        local result = table.clone(sample)
        result.LookYaw = yaw
        result.Move = Vector2.new(relative.X, relative.Z)
        if self.LookDown then result.VerticalLook = -math.sin(math.rad(math.clamp(self.Pitch, 0, 89))) end
        return result
    end
    function module:PauseReason(character, now)
        local reason = context.CombatPauseReason()
        if reason then return reason end
        if character.IsDestroyed then return "Waiting to spawn" end
        local state = character.MovementState
        if state and state.MovementMode == "Ladder" then return "Climbing" end
        if character.IsPlantingBomb or player:GetAttribute("IsDefusingBomb") or player:GetAttribute("IsLocallyDefusingBomb") then return "Interacting" end
        if self.PauseShooting then
            local item = inventory.peekCurrentEquippedForMovement()
            local trigger = context.Modules.trigger
            if input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                or input:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
                or (item and (item.IsShooting or item.IsChargeFiring))
                or (trigger and trigger.LastShotAt and now - trigger.LastShotAt < 0.15) then return "Firing" end
        end
        return nil
    end
    function module:Detach()
        if attached and attached.SampleInput == wrapper then attached.SampleInput = previousOwn end
        attached, previousOwn, wrapper = nil, nil, nil
    end
    function module:Attach(character)
        if character == attached then return end
        self:Detach()
        phaseStarted = os.clock()
        if not character or character.IsDestroyed or type(character.SampleInput) ~= "function" then
            self.Status = "Waiting to spawn"
            return
        end
        local original = character.SampleInput
        previousOwn = rawget(character, "SampleInput")
        attached = character
        wrapper = function(selfCharacter, ...)
            local sample = original(selfCharacter, ...)
            if not module.Enabled or selfCharacter ~= attached or not sample then return sample end
            local now = os.clock()
            local reason = module:PauseReason(selfCharacter, now)
            if reason then phaseStarted = now; module.Status = reason; return sample end
            local ok, rotated = pcall(module.RotateSample, module, sample, now)
            if not ok then module.Status = "Rotation error: " .. tostring(rotated); return sample end
            module.Status = "Rotating"
            module.Samples += 1
            module.LastYaw, module.LastPitch = rotated.LookYaw, rotated.VerticalLook
            return rotated
        end
        character.SampleInput = wrapper
        self.Status = "Ready"
    end
    function module:SetEnabled(value)
        if connection then connection:Disconnect(); connection = nil end
        self:Detach()
        self.Enabled = value == true
        self.Status = self.Enabled and "Waiting to spawn" or "Off"
        if not self.Enabled then return end
        self:Attach(controller.getCurrentCharacter())
        connection = run.Heartbeat:Connect(function()
            if not context.IsDestroyed() then self:Attach(controller.getCurrentCharacter()) end
        end)
    end
    local toggle = context.Tab:AddToggle("BloxSenseRotation", {
        Title = "Body rotation", Description = "Changes sampled body direction; keeps your camera steady.", Default = false,
    })
    module.Toggle = toggle
    toggle:OnChanged(function() module:SetEnabled(toggle.Value) end)
    context.Tab:AddSlider("BloxSenseRotationSpeed", {Title = "Rotation speed (degrees/sec)",
        Default = 720, Min = 30, Max = 2160, Rounding = 0, Callback = function(value) module.Speed = value end})
    local down = context.Tab:AddToggle("BloxSenseRotationLookDown", {Title = "Look down", Default = true})
    down:OnChanged(function() module.LookDown = down.Value end)
    context.Tab:AddSlider("BloxSenseRotationPitch", {Title = "Downward angle (degrees)",
        Default = 75, Min = 0, Max = 89, Rounding = 0, Callback = function(value) module.Pitch = value end})
    local pause = context.Tab:AddToggle("BloxSenseRotationPause", {Title = "Pause while firing", Default = true})
    pause:OnChanged(function() module.PauseShooting = pause.Value end)
    context.Tab:AddButton({Title = "Rotation status", Callback = function()
        context.Notify("Body rotation", module.Status .. " · " .. module.Speed .. "°/s · input samples: " .. module.Samples)
    end})
    function module:Destroy() self:SetEnabled(false) end
    return module
end
end)()

Modules["hitboxes"] = (function()
return function(context)
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    local run = game:GetService("RunService")
    local module = {Enabled = false, Show = false, Scale = 2, Opacity = 20, ThroughWalls = true,
        MaxDistance = 500, PauseSpectating = true, Parts = {Head = true}, Modified = 0, Drawn = 0}
    local bullet = require(game.ReplicatedStorage.Components.Weapon.Classes.Bullet)
    type HitboxRecord = {Box: BoxHandleAdornment?}
    local records: {[BasePart]: HitboxRecord} = {}
    local connection
    local gui = Instance.new("ScreenGui")
    gui.Name = "BloxSenseHitboxes"
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")
    local function remove(part, record)
        if record.Box then record.Box:Destroy() end
        records[part] = nil
    end
    function module:RestoreAll()
        for part, record in pairs(records) do remove(part, record) end
        self.Modified, self.Drawn = 0, 0
    end
    function module:IsPaused()
        local own = player.Character
        return context.IsDestroyed() or not workspace.CurrentCamera
            or (self.PauseSpectating and (player:GetAttribute("IsSpectating") == true
                or not own or own:GetAttribute("Dead") == true))
    end
    function module:IsEligible(part)
        if not part.Parent or not self.Parts[part.Name] then return false end
        local owner = context.Targeting:PlayerFromHit(part)
        return context.Targeting:IsEnemy(owner) and context.Targeting:IsAlive(owner)
            and (part.Position - workspace.CurrentCamera.CFrame.Position).Magnitude <= self.MaxDistance
    end
    -- Oriented-box intersection in part space. The visible mesh and physics stay unchanged.
    function module:IntersectPart(part, origin, direction)
        if not self.Enabled or not records[part] or direction.Magnitude < 0.00001 then return nil end
        local cf, half = part.CFrame, part.Size * math.clamp(self.Scale, 1, 4) * 0.5
        local p, d = cf:PointToObjectSpace(origin), cf:VectorToObjectSpace(direction)
        local near, far, normal = 0, 1, -direction.Unit
        for _, axis in ipairs({"X", "Y", "Z"}) do
            local position, delta, extent = p[axis], d[axis], half[axis]
            if math.abs(delta) < 0.000001 then
                if position < -extent or position > extent then return nil end
            else
                local first, last = (-extent - position) / delta, (extent - position) / delta
                if first > last then first, last = last, first end
                if first > near then
                    near = first
                    local sign = delta > 0 and -1 or 1
                    local localNormal = axis == "X" and Vector3.new(sign, 0, 0)
                        or axis == "Y" and Vector3.new(0, sign, 0) or Vector3.new(0, 0, sign)
                    normal = cf:VectorToWorldSpace(localNormal)
                end
                far = math.min(far, last)
                if near > far then return nil end
            end
        end
        return {instance = part, position = origin + direction * near, normal = normal,
            material = part.Material, distance = direction.Magnitude * near, virtual = true}
    end
    function module:Cast(origin, direction, limit)
        if not self.Enabled or self:IsPaused() then return nil end
        local nearest, best = math.min(limit or direction.Magnitude, direction.Magnitude), nil
        for part in pairs(records) do
            if self:IsEligible(part) then
                local hit = self:IntersectPart(part, origin, direction)
                if hit and hit.distance < nearest then nearest, best = hit.distance, hit end
            end
        end
        return best
    end
    function module:ApplyPart(part, color)
        local record = records[part]
        if not record then record = {}; records[part] = record end
        if self.Show and not record.Box then
            local box = Instance.new("BoxHandleAdornment")
            box.Name = "Hitbox_" .. part.Name
            box.Adornee = part
            box.ZIndex = 1
            box.Parent = gui
            record.Box = box
        end
        if record.Box then
            record.Box.Size = part.Size * (self.Enabled and math.clamp(self.Scale, 1, 4) or 1)
            record.Box.Color3 = color
            record.Box.Transparency = 1 - self.Opacity / 100
            record.Box.AlwaysOnTop = self.ThroughWalls
            record.Box.Visible = self.Show
        end
        return self.Enabled and self.Scale > 1, self.Show
    end
    function module:Update()
        if self:IsPaused() or (not self.Enabled and not self.Show) then self:RestoreAll(); return end
        local seen = {}
        self.Modified, self.Drawn = 0, 0
        for _, other in ipairs(players:GetPlayers()) do
            if not context.Targeting:IsEnemy(other) or not context.Targeting:IsAlive(other) then continue end
            local character = other.Character
            if not character then continue end
            local team = other:GetAttribute("Team") or (other.Team and other.Team.Name)
            local color = team == "Counter-Terrorists" and Color3.fromRGB(60,140,255) or Color3.fromRGB(255,65,65)
            for name, selected in pairs(self.Parts) do
                if not selected then continue end
                local part = character:FindFirstChild(name)
                if not part or not part:IsA("BasePart") or not self:IsEligible(part) then continue end
                seen[part] = true
                local changed, shown = self:ApplyPart(part, color)
                if changed then self.Modified += 1 end
                if shown then self.Drawn += 1 end
            end
        end
        for part, record in pairs(records) do if not seen[part] then remove(part, record) end end
    end
    function module:Refresh()
        if connection then connection:Disconnect(); connection = nil end
        self:Update()
        if self.Enabled or self.Show then
            local elapsed = 0
            connection = run.Heartbeat:Connect(function(dt)
                elapsed += dt
                if elapsed < 0.1 then return end
                elapsed = 0
                self:Update()
            end)
        end
    end
    function module:TransformShot(shot, range)
        if type(shot) ~= "table" or typeof(shot.Origin) ~= "Vector3" or typeof(shot.Direction) ~= "Vector3"
            or type(shot.Hits) ~= "table" then return shot end
        local limit = math.min(shot.Distance or range, range)
        for _, impact in ipairs(shot.Hits) do
            if typeof(impact.Position) == "Vector3" then limit = math.min(limit, (impact.Position - shot.Origin).Magnitude) end
        end
        if shot.Direction.Magnitude < 0.00001 then return shot end
        local hit = self:Cast(shot.Origin, shot.Direction.Unit * range, limit)
        if not hit then return shot end
        -- Preserve spread, origin, and the original body part used by damage mapping.
        -- Only substitute a hit before the first physical impact, never through a wall.
        local result = table.clone(shot)
        result.Distance = hit.distance
        result.Hits = {{Instance = hit.instance, Position = hit.position, Normal = hit.normal,
            Material = hit.material.Name, Exit = false}}
        return result
    end
    local originalCreate = bullet.create
    assert(type(originalCreate) == "function", "Bullet creation adapter unavailable")
    local createWrapper = function(weaponBullet, ...)
        local shot = originalCreate(weaponBullet, ...)
        if not module.Enabled or not context.IsCombatActive() then return shot end
        local ok, expanded = pcall(module.TransformShot, module, shot, weaponBullet.Properties.Range or 500)
        return ok and expanded or shot
    end
    bullet.create = createWrapper
    context.Tab.Raw:CreateSection({name = "ENEMY HITBOXES"})
    local toggle = context.Tab:AddToggle("BloxSenseHitboxExpand", {Title = "Expand enemy hitboxes",
        Description = "Invisible hit regions; character models keep their normal size. Server acceptance is unverified.", Default = false})
    module.Toggle = toggle
    toggle:OnChanged(function() module.Enabled = toggle.Value; module:Refresh() end)
    context.Tab:AddSlider("BloxSenseHitboxScale", {Title = "Size multiplier", Default = 2,
        Min = 1, Max = 4, Rounding = 1, Callback = function(value) module.Scale = value; module:Update() end})
    local parts = context.Tab:AddDropdown("BloxSenseHitboxParts", {Title = "Body parts",
        Values = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}, Default = {"Head"}})
    parts:OnChanged(function(value)
        local selected = {}
        for key, enabled in pairs(value or {}) do
            if type(key) == "number" then selected[enabled] = true elseif enabled then selected[key] = true end
        end
        module.Parts = selected; module:Update()
    end)
    context.Tab.Raw:CreateSection({name = "FILTERS"})
    context.Tab:AddSlider("BloxSenseHitboxDistance", {Title = "Maximum distance (studs)", Default = 500,
        Min = 50, Max = 2000, Rounding = 0, Callback = function(value) module.MaxDistance = value; module:Update() end})
    local pause = context.Tab:AddToggle("BloxSenseHitboxSpectate", {Title = "Pause while spectating", Default = true})
    pause:OnChanged(function() module.PauseSpectating = pause.Value; module:Update() end)
    local display = context.Tab2 or context.Tab
    display.Raw:CreateSection({name = "DISPLAY"})
    local show = display:AddToggle("BloxSenseHitboxShow", {Title = "Show hitboxes", Default = false})
    show:OnChanged(function() module.Show = show.Value; module:Refresh() end)
    display:AddSlider("BloxSenseHitboxOpacity", {Title = "Opacity (%)", Default = 20,
        Min = 5, Max = 80, Rounding = 0, Callback = function(value) module.Opacity = value; module:Update() end})
    local walls = display:AddToggle("BloxSenseHitboxWalls", {Title = "Show through walls", Default = true})
    walls:OnChanged(function() module.ThroughWalls = walls.Value; module:Update() end)
    display:AddButton({Title = "Hitbox status", Callback = function()
        context.Notify("Hitboxes", module.Modified .. " enlarged · " .. module.Drawn .. " displayed locally")
    end})
    function module:Destroy()
        self.Enabled, self.Show = false, false
        if connection then connection:Disconnect(); connection = nil end
        self:RestoreAll()
        if bullet.create == createWrapper then bullet.create = originalCreate end
        gui:Destroy()
    end
    return module
end
end)()

Modules["radar"] = (function()
-- Draws enemy dots directly on the GAME's radar using its own live map
-- projection (Minimap part + Map ImageRectOffset/Size/Rotation).
return function(context)
    local players = game:GetService("Players")
    local cs = game:GetService("CollectionService")
    local run = game:GetService("RunService")
    local player = players.LocalPlayer
    local module = { Enabled = false, DotSize = 10 }
    local connection
    local dots = {}
    local minimapRef, lastRefCheck = nil, 0
    local template
    local function gameRadar()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local mg = pg and pg:FindFirstChild("MainGui")
        local gp = mg and mg:FindFirstChild("Gameplay")
        local mid = gp and gp:FindFirstChild("Middle")
        local r = mid and mid:FindFirstChild("Radar")
        local frame = r and r:FindFirstChild("Radar")
        if frame and frame:IsA("Frame") then return frame end
        return nil
    end
    local function getRef()
        local now = os.clock()
        if minimapRef and now - lastRefCheck < 2 then return minimapRef end
        lastRefCheck = now
        minimapRef = nil
        local map = workspace:FindFirstChild("Map")
        if map then
            for _, v in ipairs(cs:GetTagged("Minimap")) do
                if v:IsA("BasePart") and v:IsDescendantOf(map) then
                    local ts = v:GetAttribute("TextureSize")
                    minimapRef = { Part = v, Size = v.Size, Tex = (type(ts) == "number" and ts > 0) and ts or 1024 }
                    break
                end
            end
        end
        return minimapRef
    end
    local function project(mapImg, worldPos)
        local ref = getRef()
        if not ref then return nil end
        local rel = ref.Part.CFrame:PointToObjectSpace(worldPos)
        local ro, rs = mapImg.ImageRectOffset, mapImg.ImageRectSize
        if rs.X == 0 or rs.Y == 0 or ref.Size.X == 0 or ref.Size.Z == 0 then return nil end
        local u = ((-rel.X / ref.Size.X + 0.5) * ref.Tex - ro.X) / rs.X
        local v = ((-rel.Z / ref.Size.Z + 0.5) * ref.Tex - ro.Y) / rs.Y
        local rot = mapImg.Rotation or 0
        if rot ~= 0 then
            local r = math.rad(rot)
            local c, s = math.cos(r), math.sin(r)
            local du, dv = u - 0.5, v - 0.5
            u = 0.5 + (du * c - dv * s)
            v = 0.5 + (du * s + dv * c)
        end
        local du, dv = u - 0.5, v - 0.5
        local m = math.sqrt(du * du + dv * dv)
        if m > 0.5 then u, v = 0.5 + du / m * 0.5, 0.5 + dv / m * 0.5 end
        return u, v
    end
    local function getTemplate()
        if template and template.Parent then return template end
        template = nil
        local ok, assets = pcall(function()
            return game:GetService("ReplicatedStorage").Assets.UI.Radar
        end)
        local t = ok and assets and assets:FindFirstChild("Enemy")
        if t and t:IsA("GuiObject") then template = t end
        return template
    end
    local function getDot(frame, p)
        local d = dots[p]
        if d and d.Parent == frame then return d end
        if d and d.Parent then d:Destroy() end
        local t = getTemplate()
        if t then
            d = t:Clone()
            d.Name = "BS_" .. p.UserId
            d.AnchorPoint = Vector2.new(0.5, 0.5)
            d.ZIndex = 30
            if d:IsA("ImageLabel") then
                d.ImageColor3 = Color3.fromRGB(255, 0, 0)
                d.BackgroundTransparency = 1
            end
            for _, ch in ipairs(d:GetChildren()) do
                if ch.Name == "Direction" then ch.Visible = false end
            end
        else
            d = Instance.new("Frame")
            d.Name = "BS_" .. p.UserId
            d.AnchorPoint = Vector2.new(0.5, 0.5)
            d.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            d.BorderSizePixel = 0
            d.ZIndex = 30
            Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)
        end
        d.Size = UDim2.fromOffset(module.DotSize, module.DotSize)
        d.Parent = frame
        dots[p] = d
        return d
    end
    local function clearDots()
        for p, d in pairs(dots) do
            if d.Parent then d:Destroy() end
            dots[p] = nil
        end
    end
    local function tick()
        if not module.Enabled or context.IsDestroyed() then return end
        local frame = gameRadar()
        if not frame then clearDots(); return end
        local mapImg = frame:FindFirstChild("Map")
        if not (mapImg and mapImg:IsA("ImageLabel")) then clearDots(); return end
        local seen = {}
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= player and context.Targeting:IsEnemy(p) and context.Targeting:IsAlive(p) then
                local char = p.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and root:IsA("BasePart") then
                    local u, v = project(mapImg, root.Position)
                    if u then
                        local d = getDot(frame, p)
                        d.Position = UDim2.fromScale(u, v)
                        d.Visible = true
                        seen[p] = true
                    end
                end
            end
        end
        for p, d in pairs(dots) do
            if not seen[p] then
                if d.Parent then d:Destroy() end
                dots[p] = nil
            end
        end
    end
    function module:SetEnabled(enabled)
        self.Enabled = enabled == true
        if connection then connection:Disconnect(); connection = nil end
        if not self.Enabled then clearDots(); return end
        local elapsed = 1
        connection = run.Heartbeat:Connect(function(dt)
            elapsed += dt
            if elapsed < 0.15 then return end
            elapsed = 0
            tick()
        end)
    end
    local toggle = context.Tab:AddToggle("BloxSenseRadar", {
        Title = "Radar", Description = "Red enemy dots on the game's own radar.", Default = false,
    })
    module.Toggle = toggle
    toggle:OnChanged(function() module:SetEnabled(toggle.Value) end)
    context.Tab:AddSlider("BloxSenseRadarDot", {
        Title = "Radar dot size", Default = 10, Min = 6, Max = 18, Rounding = 0,
        Callback = function(value) module.DotSize = value end,
    })
    function module:Destroy()
        self:SetEnabled(false)
    end
    return module
end
end)()

Modules["spectators"] = (function()
