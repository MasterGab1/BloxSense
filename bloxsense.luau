    local function skinNamesFor(weapon)
        local values = {}
        local folder = skinsFolder:FindFirstChild(weapon)
        if folder then
            for _, skin in ipairs(folder:GetChildren()) do
                if skin:FindFirstChild("Camera") or skin:FindFirstChild("Character") then table.insert(values, skin.Name) end
            end
        end
        table.sort(values, function(a, b)
            if a == "Stock" then return true end
            if b == "Stock" then return false end
            return a < b
        end)
        return values
