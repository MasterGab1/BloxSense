    local near,far=0,1
    for _,axis in ipairs({"X","Y","Z"})do
        if math.abs(d[axis])<0.000001 then
            if math.abs(p[axis])>half[axis]then return nil end
        else
            local a,b=(-half[axis]-p[axis])/d[axis],(half[axis]-p[axis])/d[axis]
            if a>b then a,b=b,a end
