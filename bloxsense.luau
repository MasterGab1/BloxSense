    end
    local ok, err = pcall(function()
        local inputController = require(game:GetService("ReplicatedStorage").Controllers.InputController)
        local registry
        for _, value in pairs(debug.getupvalues(inputController.registerAction)) do
            if type(value) == "table" then
                for _, action in pairs(value) do
                    if type(action) == "table" and type(action.Callback) == "function" and action.Keybinds then
                        registry = value
                        break
                    end
                end
            end
            if registry then break end
        end
        assert(registry, "Game input actions are unavailable")
        -- Wrap every registered action so changing the game's wheel bindings is
        -- also covered. Keyboard, gamepad and mouse-button events pass through.
        for _, action in pairs(registry) do
            if type(action) == "table" and type(action.Callback) == "function" then
                local original = action.Callback
                local function guarded(state, input, ...)
                    if input and input.UserInputType == Enum.UserInputType.MouseWheel and menuOpen() then
                        return
                    end
                    return original(state, input, ...)
                end
                table.insert(patches, {Action = action, Original = original, Guarded = guarded})
                action.Callback = guarded
            end
        end
    end)
    if not ok then warn("BloxSense scroll guard: " .. tostring(err)) end
    actionService:BindActionAtPriority(binding, function()
        return menuOpen() and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
    end, false, Enum.ContextActionPriority.High.Value + 100, Enum.UserInputType.MouseWheel)
    featureModules.MenuInput = {
        IsBlocking = menuOpen,
        Destroy = function()
            active = false
            actionService:UnbindAction(binding)
            for _, patch in ipairs(patches) do
                if patch.Action.Callback == patch.Guarded then
                    patch.Action.Callback = patch.Original
                end
            end
            table.clear(patches)
        end,
    }
end

