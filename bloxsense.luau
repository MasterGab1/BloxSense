local function cleanup()
    if cleaned then return end
    setESPEnabled(false)
    cleaned = true
    -- Flip every feature toggle off first so the menu shows the
    -- true post-unload state, then forget the menu key. Destroying the
    -- Rayfield unload disconnects its keybinds and UI listeners.
    for _, feature in pairs(featureModules) do
        local t = feature.Toggle
        if t then pcall(function() t:SetValue(false) end) end
    end
    for _, feature in pairs(featureModules) do
        if feature.Destroy then
            local ok, err = pcall(function() feature:Destroy() end)
            if not ok then warn("BloxSense cleanup: " .. tostring(err)) end
        end
    end
    focusLost:Disconnect()
    focusGained:Disconnect()
    local oldFov = playerGui:FindFirstChild("BloxSenseFOV")
    if oldFov then oldFov:Destroy() end
    local runtime = playerGui:FindFirstChild("BloxSenseRuntime", true)
    if runtime then runtime:Destroy() end
    espFolder:Destroy()
    environment.BloxSenseCleanup = nil
    environment.BloxSenseController = nil
    if not Window.unloaded then pcall(function() Window:Unload() end) end

end
