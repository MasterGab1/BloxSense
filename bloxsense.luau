local function getHealth(character)
    local health = character:GetAttribute("Health")
    local maxHealth = character:GetAttribute("MaxHealth")
    if type(health) == "number" then return health, type(maxHealth) == "number" and maxHealth or nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then return humanoid.Health, humanoid.MaxHealth end
    return nil, nil
